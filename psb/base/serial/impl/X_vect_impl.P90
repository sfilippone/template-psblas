submodule (psb_@X@_multivect_mod) psb_@X@_multivect_impl
  use psb_base_mod
  use psi_serial_mod

contains
  
  module function @X@_mvect_get_dupl(x) result(res)
    class(psb_@X@_multivect_type), intent(in) :: x
    integer(psb_ipk_) :: res
    res = x%dupl
  end function @X@_mvect_get_dupl

  module subroutine @X@_mvect_set_dupl(x,val)
    class(psb_@X@_multivect_type), intent(inout) :: x
    integer(psb_ipk_), intent(in), optional :: val

    if (present(val)) then
      x%dupl = val
    else
      x%dupl = psb_dupl_def_
    end if
  end subroutine @X@_mvect_set_dupl
        
  module function @X@_mvect_is_remote_build(x) result(res)
    class(psb_@X@_multivect_type), intent(in) :: x
    logical :: res
    res = (x%remote_build == psb_matbld_remote_)
  end function @X@_mvect_is_remote_build

  module subroutine @X@_mvect_set_remote_build(x,val)
    class(psb_@X@_multivect_type), intent(inout) :: x
    integer(psb_ipk_), intent(in), optional :: val

    if (present(val)) then
      x%remote_build = val
    else
      x%remote_build = psb_matbld_remote_
    end if
  end subroutine @X@_mvect_set_remote_build
       
  module subroutine @X@_mvect_clone(x,y,info)
    class(psb_@X@_multivect_type), intent(inout) :: x
    class(psb_@X@_multivect_type), intent(inout) :: y
    integer(psb_ipk_), intent(out)        :: info

    info = psb_success_
    call y%free(info)
    if ((info==0).and.allocated(x%v)) then
      call y%bld_x(x%get_vect(),mold=x%v)
    end if
  end subroutine @X@_mvect_clone

  module subroutine @X@_mvect_bld_x(x,invect,mold)
    @TYPE@(@FKIND@), intent(in)          :: invect(:,:)
    class(psb_@X@_multivect_type), intent(out) :: x
    class(psb_@X@_base_multivect_type), intent(in), optional :: mold
    integer(psb_ipk_) :: info
    class(psb_@X@_base_multivect_type), pointer :: mld

    info = psb_success_
    if (present(mold)) then
      allocate(x%v,stat=info,mold=mold)
    else
      allocate(x%v,stat=info, mold=psb_@X@_get_base_multivect_default())
    endif

    if (info == psb_success_) call x%v%bld(invect)

  end subroutine @X@_mvect_bld_x

  module subroutine @X@_mvect_bld_n(x,m,n,mold,scratch)
    integer(psb_ipk_), intent(in) :: m,n
    class(psb_@X@_multivect_type), intent(out) :: x
    class(psb_@X@_base_multivect_type), intent(in), optional :: mold
    integer(psb_ipk_) :: info
    logical, intent(in), optional        :: scratch
    
    info = psb_success_
    if (present(mold)) then
      allocate(x%v,stat=info,mold=mold)
    else
      allocate(x%v,stat=info, mold=psb_@X@_get_base_multivect_default())
    endif
    if (info == psb_success_) call x%v%bld(m,n,scratch=scratch)

  end subroutine @X@_mvect_bld_n

  module function  @X@_mvect_get_vect(x) result(res)
    class(psb_@X@_multivect_type), intent(inout)  :: x
    @TYPE@(@FKIND@), allocatable                 :: res(:,:)
    integer(psb_ipk_) :: info

    if (allocated(x%v)) then
      res = x%v%get_vect()
    end if
  end function @X@_mvect_get_vect

  module subroutine @X@_mvect_set_scal(x,val)
    class(psb_@X@_multivect_type), intent(inout)  :: x
    @TYPE@(@FKIND@), intent(in) :: val

    integer(psb_ipk_) :: info
    if (allocated(x%v)) call x%v%set(val)

  end subroutine @X@_mvect_set_scal

  module subroutine @X@_mvect_set_vect(x,val)
    class(psb_@X@_multivect_type), intent(inout) :: x
    @TYPE@(@FKIND@), intent(in)         :: val(:,:)

    integer(psb_ipk_) :: info
    if (allocated(x%v)) call x%v%set(val)

  end subroutine @X@_mvect_set_vect

  module function @X@_mvect_get_nrows(x) result(res)
    class(psb_@X@_multivect_type), intent(in) :: x
    integer(psb_ipk_)  :: res
    res = 0
    if (allocated(x%v)) res = x%v%get_nrows()
  end function @X@_mvect_get_nrows

  module function @X@_mvect_get_ncols(x) result(res)
    class(psb_@X@_multivect_type), intent(in) :: x
    integer(psb_ipk_) :: res
    res = 0
    if (allocated(x%v)) res = x%v%get_ncols()
  end function @X@_mvect_get_ncols

  module function @X@_mvect_sizeof(x) result(res)
    class(psb_@X@_multivect_type), intent(in) :: x
    integer(psb_epk_) :: res
    res = 0
    if (allocated(x%v)) res = x%v%sizeof()
  end function @X@_mvect_sizeof

  module function @X@_mvect_get_fmt(x) result(res)
    class(psb_@X@_multivect_type), intent(in) :: x
    character(len=5) :: res
    res = 'NULL'
    if (allocated(x%v)) res = x%v%get_fmt()
  end function @X@_mvect_get_fmt

  module subroutine @X@_mvect_all(m,n, x, info, mold)

    integer(psb_ipk_), intent(in)       :: m,n
    class(psb_@X@_multivect_type), intent(out) :: x
    class(psb_@X@_base_multivect_type), intent(in), optional :: mold
    integer(psb_ipk_), intent(out)      :: info

    if (present(mold)) then
      allocate(x%v,stat=info,mold=mold)
    else
      allocate(psb_@X@_base_multivect_type :: x%v,stat=info)
    endif
    if (info == 0) then
      call x%v%all(m,n,info)
    else
      info = psb_err_alloc_dealloc_
    end if

  end subroutine @X@_mvect_all

  module subroutine @X@_mvect_reall(m,n, x, info)

    integer(psb_ipk_), intent(in)         :: m,n
    class(psb_@X@_multivect_type), intent(inout) :: x
    integer(psb_ipk_), intent(out)        :: info

    info = 0
    if (.not.allocated(x%v)) &
         & call x%all(m,n,info)
    if (info == 0) &
         & call x%asb(m,n,info)

  end subroutine @X@_mvect_reall

  module subroutine @X@_mvect_zero(x)
    class(psb_@X@_multivect_type), intent(inout)    :: x

    if (allocated(x%v)) call x%v%zero()

  end subroutine @X@_mvect_zero

  module subroutine @X@_mvect_asb(m,n, x, info)
    integer(psb_ipk_), intent(in)              :: m,n
    class(psb_@X@_multivect_type), intent(inout) :: x
    integer(psb_ipk_), intent(out)             :: info

    if (allocated(x%v)) &
         & call x%v%asb(m,n,info)

  end subroutine @X@_mvect_asb

  module subroutine @X@_mvect_sync(x)
    class(psb_@X@_multivect_type), intent(inout) :: x

    if (allocated(x%v)) &
         & call x%v%sync()

  end subroutine @X@_mvect_sync

  module subroutine @X@_mvect_gthab(n,idx,alpha,x,beta,y)
    integer(psb_mpk_) :: n
    integer(psb_ipk_) :: idx(:)
    @TYPE@(@FKIND@) :: alpha, beta, y(:)
    class(psb_@X@_multivect_type) :: x

    if (allocated(x%v)) &
         &  call x%v%gth(n,idx,alpha,beta,y)

  end subroutine @X@_mvect_gthab

  module subroutine @X@_mvect_gthzv(n,idx,x,y)
    integer(psb_mpk_) :: n
    integer(psb_ipk_) :: idx(:)
    @TYPE@(@FKIND@) ::  y(:)
    class(psb_@X@_multivect_type) :: x

    if (allocated(x%v)) &
         &  call x%v%gth(n,idx,y)

  end subroutine @X@_mvect_gthzv

  module subroutine @X@_mvect_gthzv_x(i,n,idx,x,y)
    integer(psb_mpk_) :: n
    integer(psb_ipk_) :: i
    class(psb_i_base_vect_type) :: idx
    @TYPE@(@FKIND@) ::  y(:)
    class(psb_@X@_multivect_type) :: x

    if (allocated(x%v)) &
         &  call x%v%gth(i,n,idx,y)

  end subroutine @X@_mvect_gthzv_x

  module subroutine @X@_mvect_sctb(n,idx,x,beta,y)
    integer(psb_mpk_) :: n
    integer(psb_ipk_) :: idx(:)
    @TYPE@(@FKIND@) :: beta, x(:)
    class(psb_@X@_multivect_type) :: y

    if (allocated(y%v)) &
         &  call y%v%sct(n,idx,x,beta)

  end subroutine @X@_mvect_sctb

  module subroutine @X@_mvect_sctb_x(i,n,idx,x,beta,y)
    integer(psb_mpk_) :: n
    integer(psb_ipk_) :: i
    class(psb_i_base_vect_type) :: idx
    @TYPE@(@FKIND@) :: beta, x(:)
    class(psb_@X@_multivect_type) :: y

    if (allocated(y%v)) &
         &  call y%v%sct(i,n,idx,x,beta)

  end subroutine @X@_mvect_sctb_x

  module subroutine @X@_mvect_free(x, info)
    class(psb_@X@_multivect_type), intent(inout)  :: x
    integer(psb_ipk_), intent(out)              :: info

    info = 0
    if (allocated(x%v)) then
      call x%v%free(info)
      if (info == 0) deallocate(x%v,stat=info)
    end if

  end subroutine @X@_mvect_free

  module subroutine @X@_mvect_ins(n,irl,val,x,maxr,info)
    class(psb_@X@_multivect_type), intent(inout)  :: x
    integer(psb_ipk_), intent(in)               :: n,maxr
    integer(psb_ipk_), intent(in)               :: irl(:)
    @TYPE@(@FKIND@), intent(in)        :: val(:,:)
    integer(psb_ipk_), intent(out)              :: info

    integer(psb_ipk_) :: i, dupl

    info = 0
    if (.not.allocated(x%v)) then
      info = psb_err_invalid_vect_state_
      return
    end if
    dupl = x%get_dupl()
    call  x%v%ins(n,irl,val,dupl,maxr,info)

  end subroutine @X@_mvect_ins

  module subroutine @X@_mvect_cnv(x,mold)
    class(psb_@X@_multivect_type), intent(inout) :: x
    class(psb_@X@_base_multivect_type), intent(in), optional :: mold
    class(psb_@X@_base_multivect_type), allocatable :: tmp
    integer(psb_ipk_) :: info

    if (present(mold)) then
      allocate(tmp,stat=info,mold=mold)
    else
      allocate(tmp,stat=info, mold=psb_@X@_get_base_multivect_default())
    endif
    if (allocated(x%v)) then
      call x%v%sync()
      if (info == psb_success_) call tmp%bld(x%v%v)
      call x%v%free(info)
    end if
    call move_alloc(tmp,x%v)
  end subroutine @X@_mvect_cnv

  @NOTINTS@
