! package: psb_@X@_vect_mod
!
! This module contains the definition of the psb_@X@_vect type which
! is the outer container for dense vectors.
! Therefore all methods simply invoke the corresponding methods of the
! inner component.
!
submodule (psb_@X@_vect_mod) psb_@X@_vect_impl
  use psb_base_mod
  use psi_serial_mod
  implicit none 

contains

  module function @X@_vect_get_dupl(x) result(res)
    class(psb_@X@_vect_type), intent(in) :: x
    integer(psb_ipk_) :: res
    if (allocated(x%v)) then 
      res = x%v%get_dupl()
    else
      res = psb_dupl_null_
    end if
  end function @X@_vect_get_dupl

  module subroutine @X@_vect_set_dupl(x,val)
    class(psb_@X@_vect_type), intent(inout) :: x
    integer(psb_ipk_), intent(in), optional :: val

    if (allocated(x%v)) then 
      if (present(val)) then
        call x%v%set_dupl(val)
      else
        call x%v%set_dupl(psb_dupl_def_)
      end if
    end if
  end subroutine @X@_vect_set_dupl

  module function @X@_vect_get_ncfs(x) result(res)
    class(psb_@X@_vect_type), intent(in) :: x
    integer(psb_ipk_) :: res
    if (allocated(x%v)) then 
      res = x%v%get_ncfs()
    else
      res = 0
    end if
  end function @X@_vect_get_ncfs

  module subroutine @X@_vect_set_ncfs(x,val)
    class(psb_@X@_vect_type), intent(inout) :: x
    integer(psb_ipk_), intent(in), optional :: val

    if (allocated(x%v)) then 
      if (present(val)) then
        call x%v%set_ncfs(val)
      else
        call x%v%set_ncfs(0)
      end if
    end if
  end subroutine @X@_vect_set_ncfs

  module function @X@_vect_get_state(x) result(res)
    class(psb_@X@_vect_type), intent(in) :: x
    integer(psb_ipk_) :: res
    if (allocated(x%v)) then 
      res = x%v%get_state()
    else
      res = psb_vect_null_
    end if
  end function @X@_vect_get_state

  module function @X@_vect_is_null(x) result(res)
    class(psb_@X@_vect_type), intent(in) :: x
    logical :: res
    res = (x%get_state() == psb_vect_null_)
  end function @X@_vect_is_null

  module function @X@_vect_is_bld(x) result(res)
    class(psb_@X@_vect_type), intent(in) :: x
    logical :: res
    res = (x%get_state() == psb_vect_bld_)
  end function @X@_vect_is_bld

  module function @X@_vect_is_upd(x) result(res)
    class(psb_@X@_vect_type), intent(in) :: x
    logical :: res
    res = (x%get_state() == psb_vect_upd_)
  end function @X@_vect_is_upd

  module function @X@_vect_is_asb(x) result(res)
    class(psb_@X@_vect_type), intent(in) :: x
    logical :: res
    res = (x%get_state() == psb_vect_asb_)
  end function @X@_vect_is_asb

  module subroutine  @X@_vect_set_state(n,x)
    class(psb_@X@_vect_type), intent(inout) :: x
    integer(psb_ipk_), intent(in) :: n
    if (allocated(x%v)) then 
      call x%v%set_state(n)
    end if
  end subroutine @X@_vect_set_state

  module subroutine  @X@_vect_set_null(x)
    class(psb_@X@_vect_type), intent(inout) :: x

    call x%set_state(psb_vect_null_)
  end subroutine @X@_vect_set_null

  module subroutine  @X@_vect_set_bld(x)
    class(psb_@X@_vect_type), intent(inout) :: x

    call x%set_state(psb_vect_bld_)
  end subroutine @X@_vect_set_bld

  module subroutine  @X@_vect_set_upd(x)
    class(psb_@X@_vect_type), intent(inout) :: x

    call x%set_state(psb_vect_upd_)
  end subroutine @X@_vect_set_upd

  module subroutine  @X@_vect_set_asb(x)
    class(psb_@X@_vect_type), intent(inout) :: x

    call x%set_state(psb_vect_asb_)
  end subroutine @X@_vect_set_asb

  module function @X@_vect_get_nrmv(x) result(res)
    class(psb_@X@_vect_type), intent(in) :: x
    integer(psb_ipk_) :: res
    res = x%nrmv
  end function @X@_vect_get_nrmv

  module subroutine @X@_vect_set_nrmv(x,val)
    class(psb_@X@_vect_type), intent(inout) :: x
    integer(psb_ipk_), intent(in) :: val

    x%nrmv = val
  end subroutine @X@_vect_set_nrmv

  module function @X@_vect_is_remote_build(x) result(res)
    class(psb_@X@_vect_type), intent(in) :: x
    logical :: res
    res = (x%remote_build == psb_matbld_remote_)
  end function @X@_vect_is_remote_build

  module subroutine @X@_vect_set_remote_build(x,val)
    class(psb_@X@_vect_type), intent(inout) :: x
    integer(psb_ipk_), intent(in), optional :: val

    if (present(val)) then
      x%remote_build = val
    else
      x%remote_build = psb_matbld_remote_
    end if
  end subroutine @X@_vect_set_remote_build

  module subroutine @X@_vect_clone(x,y,info)
    class(psb_@X@_vect_type), intent(inout) :: x
    class(psb_@X@_vect_type), intent(inout) :: y
    integer(psb_ipk_), intent(out)        :: info

    info = psb_success_
    call y%free(info)
    if ((info==0).and.allocated(x%v)) then
      !
      ! Using sourced allocation here creates
      ! problems with handling of memory allocated
      ! elsewhere (e.g. accelerators), hence delegation
      ! to %bld method
      ! 
      call y%bld(x%get_vect(),mold=x%v)
    end if
  end subroutine @X@_vect_clone

  module subroutine @X@_vect_bld_x(x,invect,mold,scratch)
    @TYPE@(@FKIND@), intent(in)          :: invect(:)
    class(psb_@X@_vect_type), intent(inout) :: x
    class(psb_@X@_base_vect_type), intent(in), optional :: mold
    logical, intent(in), optional        :: scratch

    logical :: scratch_
    integer(psb_ipk_) :: info

    if (present(scratch)) then
      scratch_ = scratch
    else
      scratch_ = .false.
    end if

    info = psb_success_
    if (allocated(x%v)) &
         & call x%free(info)

    if (present(mold)) then
      allocate(x%v,stat=info,mold=mold)
    else
      allocate(x%v,stat=info, mold=psb_@X@_get_base_vect_default())
    endif

    if (info == psb_success_) call x%v%bld(invect,scratch=scratch_)

  end subroutine @X@_vect_bld_x

  module subroutine @X@_vect_bld_mn(x,n,mold,scratch)
    integer(psb_mpk_), intent(in) :: n
    class(psb_@X@_vect_type), intent(inout) :: x
    class(psb_@X@_base_vect_type), intent(in), optional :: mold
    logical, intent(in), optional        :: scratch

    logical :: scratch_
    integer(psb_ipk_) :: info
    class(psb_@X@_base_vect_type), pointer :: mld
    if (present(scratch)) then
      scratch_ = scratch
    else
      scratch_ = .false.
    end if

    info = psb_success_
    if (allocated(x%v)) &
         & call x%free(info)

    if (present(mold)) then
      allocate(x%v,stat=info,mold=mold)
    else
      allocate(x%v,stat=info, mold=psb_@X@_get_base_vect_default())
    endif
    if (info == psb_success_) call x%v%bld(n,scratch=scratch_)

  end subroutine @X@_vect_bld_mn

  module subroutine @X@_vect_bld_en(x,n,mold,scratch)
    integer(psb_epk_), intent(in) :: n
    class(psb_@X@_vect_type), intent(inout) :: x
    class(psb_@X@_base_vect_type), intent(in), optional :: mold
    logical, intent(in), optional        :: scratch

    logical :: scratch_
    integer(psb_ipk_) :: info

    info = psb_success_
    if (present(scratch)) then
      scratch_ = scratch
    else
      scratch_ = .false.
    end if

    if (allocated(x%v)) &
         & call x%free(info)

    if (present(mold)) then
      allocate(x%v,stat=info,mold=mold)
    else
      allocate(x%v,stat=info, mold=psb_@X@_get_base_vect_default())
    endif
    if (info == psb_success_) call x%v%bld(n,scratch=scratch_)

  end subroutine @X@_vect_bld_en

  module function  @X@_vect_get_vect(x,n) result(res)
    class(psb_@X@_vect_type), intent(inout)  :: x
    @TYPE@(@FKIND@), allocatable                 :: res(:)
    integer(psb_ipk_) :: info
    integer(psb_ipk_), optional :: n

    if (allocated(x%v)) then
      res = x%v%get_vect(n)
    end if
  end function @X@_vect_get_vect

  module subroutine @X@_vect_set_scal(x,val,first,last)
    class(psb_@X@_vect_type), intent(inout)  :: x
    @TYPE@(@FKIND@), intent(in) :: val
    integer(psb_ipk_), optional :: first, last

    integer(psb_ipk_) :: info
    if (allocated(x%v)) call x%v%set(val,first,last)

  end subroutine @X@_vect_set_scal

  module subroutine @X@_vect_set_vect(x,val,first,last)
    class(psb_@X@_vect_type), intent(inout) :: x
    @TYPE@(@FKIND@), intent(in)         :: val(:)
    integer(psb_ipk_), optional :: first, last

    integer(psb_ipk_) :: info
    if (allocated(x%v)) call x%v%set(val,first,last)

  end subroutine @X@_vect_set_vect

  module subroutine @X@_vect_check_addr(x)
    class(psb_@X@_vect_type), intent(inout) :: x

    integer(psb_ipk_) :: info
    if (allocated(x%v)) call x%v%check_addr()

  end subroutine @X@_vect_check_addr

  module function @X@_vect_get_nrows(x) result(res)
    class(psb_@X@_vect_type), intent(in) :: x
    integer(psb_ipk_) :: res
    res = 0
    if (allocated(x%v)) res = x%v%get_nrows()
  end function @X@_vect_get_nrows

  module function @X@_vect_sizeof(x) result(res)
    class(psb_@X@_vect_type), intent(in) :: x
    integer(psb_epk_) :: res
    res = 0
    if (allocated(x%v)) res = x%v%sizeof()
  end function @X@_vect_sizeof

  module function @X@_vect_get_fmt(x) result(res)
    class(psb_@X@_vect_type), intent(in) :: x
    character(len=5) :: res
    res = 'NULL'
    if (allocated(x%v)) res = x%v%get_fmt()
  end function @X@_vect_get_fmt

  module subroutine @X@_vect_all(n, x, info, mold)

    integer(psb_ipk_), intent(in)           :: n
    class(psb_@X@_vect_type), intent(inout) :: x
    integer(psb_ipk_), intent(out)      :: info
    class(psb_@X@_base_vect_type), intent(in), optional :: mold

    if (allocated(x%v)) &
         & call x%free(info)

    if (present(mold)) then
      allocate(x%v,stat=info,mold=mold)
    else
      allocate(psb_@X@_base_vect_type :: x%v,stat=info)
    endif
    if (info == 0) then
      call x%v%all(n,info)
    else
      info = psb_err_alloc_dealloc_
    end if
    call x%set_bld()
  end subroutine @X@_vect_all

  module subroutine @X@_vect_reinit(x, info, clear)
    class(psb_@X@_vect_type), intent(inout) :: x
    integer(psb_ipk_), intent(out)      :: info
    logical, intent(in), optional       :: clear

    if (allocated(x%v)) call x%v%reinit(info,clear)
    call x%set_upd()

  end subroutine @X@_vect_reinit
 
  module subroutine @X@_vect_reall(n, x, info)

    integer(psb_ipk_), intent(in)         :: n
    class(psb_@X@_vect_type), intent(inout) :: x
    integer(psb_ipk_), intent(out)        :: info

    info = 0
    if (.not.allocated(x%v)) &
         & call x%all(n,info)
    if (info == 0) &
         & call x%asb(n,info)

  end subroutine @X@_vect_reall

  module subroutine @X@_vect_zero(x)
    class(psb_@X@_vect_type), intent(inout)    :: x

    if (allocated(x%v)) call x%v%zero()

  end subroutine @X@_vect_zero

  module subroutine @X@_vect_asb(n, x, info, scratch)
    integer(psb_ipk_), intent(in)         :: n
    class(psb_@X@_vect_type), intent(inout) :: x
    integer(psb_ipk_), intent(out)        :: info
    logical, intent(in), optional        :: scratch

    if (allocated(x%v)) then
      call x%v%asb(n,info,scratch=scratch)
      call x%set_asb()
    end if
  end subroutine @X@_vect_asb

  module subroutine @X@_vect_gthab(n,idx,alpha,x,beta,y)
    integer(psb_mpk_) :: n
    integer(psb_ipk_) :: idx(:)
    @TYPE@(@FKIND@) :: alpha, beta, y(:)
    class(psb_@X@_vect_type) :: x

    if (allocated(x%v)) &
         &  call x%v%gth(n,idx,alpha,beta,y)

  end subroutine @X@_vect_gthab

  module subroutine @X@_vect_gthzv(n,idx,x,y)
    integer(psb_mpk_) :: n
    integer(psb_ipk_) :: idx(:)
    @TYPE@(@FKIND@) ::  y(:)
    class(psb_@X@_vect_type) :: x

    if (allocated(x%v)) &
         &  call x%v%gth(n,idx,y)

  end subroutine @X@_vect_gthzv

  module subroutine @X@_vect_sctb(n,idx,x,beta,y)
    integer(psb_mpk_) :: n
    integer(psb_ipk_) :: idx(:)
    @TYPE@(@FKIND@) :: beta, x(:)
    class(psb_@X@_vect_type) :: y

    if (allocated(y%v)) &
         &  call y%v%sct(n,idx,x,beta)

  end subroutine @X@_vect_sctb

  module subroutine @X@_vect_free(x, info)
    class(psb_@X@_vect_type), intent(inout)  :: x
    integer(psb_ipk_), intent(out)              :: info

    info = 0
    if (allocated(x%v)) then
      call x%v%free(info)
      if (info == 0) deallocate(x%v,stat=info)
    end if

  end subroutine @X@_vect_free

  module subroutine @X@_vect_ins_a(n,irl,val,x,maxr,info)
    class(psb_@X@_vect_type), intent(inout)  :: x
    integer(psb_ipk_), intent(in)               :: n, maxr
    integer(psb_ipk_), intent(in)               :: irl(:)
    @TYPE@(@FKIND@), intent(in)        :: val(:)
    integer(psb_ipk_), intent(out)              :: info

    integer(psb_ipk_) :: i, dupl

    info = 0
    if (.not.allocated(x%v)) then
      info = psb_err_invalid_vect_state_
      return
    end if
    dupl = x%get_dupl()
    call  x%v%ins(n,irl,val,dupl,maxr,info)

  end subroutine @X@_vect_ins_a

  module subroutine @X@_vect_ins_v(n,irl,val,x,maxr,info)
    class(psb_@X@_vect_type), intent(inout)  :: x
    integer(psb_ipk_), intent(in)               :: n, maxr
    class(psb_i_vect_type), intent(inout)       :: irl
    class(psb_@X@_vect_type), intent(inout)       :: val
    integer(psb_ipk_), intent(out)              :: info

    integer(psb_ipk_) :: i, dupl

    info = 0
    if (.not.(allocated(x%v).and.allocated(irl%v).and.allocated(val%v))) then
      info = psb_err_invalid_vect_state_
      return
    end if
    dupl = x%get_dupl()
    call  x%v%ins(n,irl%v,val%v,dupl,maxr,info)

  end subroutine @X@_vect_ins_v

  module subroutine @X@_vect_cnv(x,mold)
    class(psb_@X@_vect_type), intent(inout) :: x
    class(psb_@X@_base_vect_type), intent(in), optional :: mold
    class(psb_@X@_base_vect_type), allocatable :: tmp

    integer(psb_ipk_) :: info

    info = psb_success_
    if (present(mold)) then
      allocate(tmp,stat=info,mold=mold)
    else
      allocate(tmp,stat=info,mold=psb_@X@_get_base_vect_default())
    end if
    if (allocated(x%v)) then
      if (allocated(x%v%v)) then 
        call x%v%sync()
        if (info == psb_success_) call tmp%bld(x%v%v)
        call x%v%base_cpy(tmp)
        call x%v%free(info)
      endif
    end if
    call move_alloc(tmp,x%v)

  end subroutine @X@_vect_cnv

  module subroutine @X@_vect_sync(x)
    class(psb_@X@_vect_type), intent(inout) :: x

    if (allocated(x%v)) &
         & call x%v%sync()

  end subroutine @X@_vect_sync

  module subroutine @X@_vect_set_sync(x)
    class(psb_@X@_vect_type), intent(inout) :: x

    if (allocated(x%v)) &
         & call x%v%set_sync()

  end subroutine @X@_vect_set_sync

  module subroutine @X@_vect_set_host(x)
    class(psb_@X@_vect_type), intent(inout) :: x

    if (allocated(x%v)) &
         & call x%v%set_host()

  end subroutine @X@_vect_set_host

  module subroutine @X@_vect_set_dev(x)
    class(psb_@X@_vect_type), intent(inout) :: x

    if (allocated(x%v)) &
         & call x%v%set_dev()

  end subroutine @X@_vect_set_dev

  module function @X@_vect_is_sync(x) result(res)
    logical :: res
    class(psb_@X@_vect_type), intent(inout) :: x

    res = .true.
    if (allocated(x%v)) &
         & res = x%v%is_sync()

  end function @X@_vect_is_sync

  module function @X@_vect_is_host(x) result(res)
    logical :: res
    class(psb_@X@_vect_type), intent(inout) :: x

    res = .true.
    if (allocated(x%v)) &
         & res = x%v%is_host()

  end function @X@_vect_is_host

  module function @X@_vect_is_dev(x) result(res)
    logical :: res
    class(psb_@X@_vect_type), intent(inout) :: x

    res = .false.
    if (allocated(x%v)) &
         & res =  x%v%is_dev()

  end function @X@_vect_is_dev

  @NOTINTS@
  module function @X@_vect_get_entry(x,index) result(res)
    class(psb_@X@_vect_type), intent(inout) :: x
    integer(psb_ipk_), intent(in)        :: index
    @TYPE@(@FKIND@) :: res
    res = @XZERO@
    if (allocated(x%v)) res = x%v%get_entry(index)
  end function @X@_vect_get_entry

  module subroutine @X@_vect_set_entry(x,index,val)
    class(psb_@X@_vect_type), intent(inout) :: x
    integer(psb_ipk_), intent(in)        :: index
    @TYPE@(@FKIND@) :: val
    if (allocated(x%v)) call x%v%set_entry(index,val)
  end subroutine @X@_vect_set_entry

  module function @X@_vect_dot_v(n,x,y) result(res)
    class(psb_@X@_vect_type), intent(inout) :: x, y
    integer(psb_ipk_), intent(in)           :: n
    @TYPE@(@FKIND@)                :: res

    res = @XZERO@
    if (allocated(x%v).and.allocated(y%v)) &
         & res = x%v%dot(n,y%v)

  end function @X@_vect_dot_v

  module function @X@_vect_dot_a(n,x,y) result(res)
    class(psb_@X@_vect_type), intent(inout) :: x
    @TYPE@(@FKIND@), intent(in)    :: y(:)
    integer(psb_ipk_), intent(in)           :: n
    @TYPE@(@FKIND@)                :: res

    res = @XZERO@
    if (allocated(x%v)) &
         & res = x%v%dot_a(n,y)

  end function @X@_vect_dot_a

  module subroutine @X@_vect_axpby_v(m,alpha, x, beta, y, info)
    integer(psb_ipk_), intent(in)               :: m
    class(psb_@X@_vect_type), intent(inout)  :: x
    class(psb_@X@_vect_type), intent(inout)  :: y
    @TYPE@(@FKIND@), intent (in)       :: alpha, beta
    integer(psb_ipk_), intent(out)              :: info

    if (allocated(x%v).and.allocated(y%v)) then
      call y%v%axpby(m,alpha,x%v,beta,info)
    else
      info = psb_err_invalid_vect_state_
    end if

  end subroutine @X@_vect_axpby_v

