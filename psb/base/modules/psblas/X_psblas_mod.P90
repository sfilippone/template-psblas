module psb_@X@_psblas_mod
  use psb_desc_mod, only : psb_desc_type, @FKIND@, psb_ipk_, psb_lpk_
  use psb_@X@_vect_mod, only : psb_@X@_vect_type
  use psb_@X@_multivect_mod, only : psb_@X@_multivect_type
  use psb_@X@_mat_mod, only : psb_@X@spmat_type

  interface psb_gedot
    function psb_@X@dot_vect(x, y, desc_a,info, global) result(res)
      import :: psb_@X@_vect_type, psb_desc_type, @FKIND@, psb_ipk_
      type(psb_@X@_vect_type), intent(inout) :: x, y
      type(psb_desc_type), intent(in)      :: desc_a
      integer(psb_ipk_), intent(out)       :: info
      logical, intent(in), optional :: global
      @TYPE@(@FKIND@)  :: res
    end function psb_@X@dot_vect

    function psb_@X@dotv(x, y, desc_a, info, global)
      import :: psb_desc_type, @FKIND@, psb_ipk_
      @TYPE@(@FKIND@), intent(in)      :: x(:), y(:)
      type(psb_desc_type), intent(in) :: desc_a
      integer(psb_ipk_), intent(out)  :: info
      logical, intent(in), optional :: global
      @TYPE@(@FKIND@)  :: psb_@X@dotv
    end function psb_@X@dotv

    function psb_@X@dot(x, y, desc_a, info, jx, jy, global)
      import :: psb_desc_type, @FKIND@, psb_ipk_
      @TYPE@(@FKIND@), intent(in)      :: x(:, :), y(:, :)
      type(psb_desc_type), intent(in) :: desc_a
      integer(psb_ipk_), intent(out)  :: info
      integer(psb_ipk_), optional, intent(in) :: jx, jy
      logical, intent(in), optional           :: global
      @TYPE@(@FKIND@)  :: psb_@X@dot
    end function psb_@X@dot
  end interface

  interface psb_gedots
    subroutine psb_@X@dotvs(res, x, y, desc_a, info, global)
      import :: psb_desc_type, @FKIND@, psb_ipk_
      @TYPE@(@FKIND@), intent(out)     :: res
      @TYPE@(@FKIND@), intent(in)      :: x(:), y(:)
      type(psb_desc_type), intent(in) :: desc_a
      integer(psb_ipk_), intent(out)  :: info
      logical, intent(in), optional   :: global
    end subroutine psb_@X@dotvs

    subroutine psb_@X@mdots(res, x, y, desc_a, info, global)
      import :: psb_desc_type, @FKIND@, psb_ipk_
      @TYPE@(@FKIND@), intent(out)     :: res(:)
      @TYPE@(@FKIND@), intent(in)      :: x(:, :), y(:, :)
      type(psb_desc_type), intent(in) :: desc_a
      integer(psb_ipk_), intent(out)  :: info
      logical, intent(in), optional   :: global
    end subroutine psb_@X@mdots

    ! mvect dot products now available only as subroutines. 
    ! Maybe worth to implemented them also as allocatable-output functions
    subroutine psb_@X@dot_mvect(x, y, xty, desc_a, info, global)
      import :: psb_@X@_multivect_type, psb_desc_type, @FKIND@, psb_ipk_
      type(psb_@X@_multivect_type), intent(inout) :: x, y
      @TYPE@(@FKIND@), intent(out)               :: xty(:, :)
      type(psb_desc_type), intent(in)           :: desc_a
      integer(psb_ipk_), intent(out)            :: info
      logical, intent(in), optional             :: global
    end subroutine psb_@X@dot_mvect

    subroutine psb_@X@dot_mvect_vect(x, y, xty, desc_a, info, global)
      import :: psb_@X@_multivect_type, psb_@X@_vect_type, psb_desc_type, &
              & @FKIND@, psb_ipk_
      type(psb_@X@_multivect_type), intent(inout) :: x
      type(psb_@X@_vect_type), intent(inout)      :: y
      @TYPE@(@FKIND@), intent(out)               :: xty(:)
      type(psb_desc_type), intent(in)           :: desc_a
      integer(psb_ipk_), intent(out)            :: info
      logical, intent(in), optional             :: global
    end subroutine psb_@X@dot_mvect_vect
  end interface

  interface psb_geaxpby
    subroutine psb_@X@axpby_vect(alpha, x, beta, y, desc_a, info)
      import :: psb_@X@_vect_type, psb_desc_type, &
              & @FKIND@, psb_ipk_
      @TYPE@(@FKIND@), intent(in)            :: alpha, beta
      type(psb_@X@_vect_type), intent(inout)  :: x, y
      type(psb_desc_type), intent(in)       :: desc_a
      integer(psb_ipk_), intent(out)        :: info
    end subroutine psb_@X@axpby_vect

    subroutine psb_@X@axpby_extract_c(alpha, x, idx_x, beta, y, desc_a, info)
      import :: psb_@X@_multivect_type, psb_@X@_vect_type, &
              & psb_desc_type, @FKIND@, psb_ipk_
      @TYPE@(@FKIND@), intent(in)                :: alpha, beta
      type(psb_@X@_multivect_type), intent(inout) :: x
      integer(psb_ipk_), intent(in)             :: idx_x
      type(psb_@X@_vect_type), intent(inout)      :: y
      type(psb_desc_type), intent(in)           :: desc_a
      integer(psb_ipk_), intent(out)            :: info
    end subroutine psb_@X@axpby_extract_c

    subroutine psb_@X@axpby_mv_v_full(alpha, x, beta, y, desc_a, info)
      import :: psb_@X@_multivect_type, psb_@X@_vect_type, &
              & psb_desc_type, @FKIND@, psb_ipk_
      @TYPE@(@FKIND@), intent(in)                :: alpha, beta
      type(psb_@X@_vect_type), intent(inout)      :: x
      type(psb_@X@_multivect_type), intent(inout) :: y
      type(psb_desc_type), intent(in)           :: desc_a
      integer(psb_ipk_), intent(out)            :: info
    end subroutine psb_@X@axpby_mv_v_full

    subroutine psb_@X@axpby_mv_v_idxs(alpha, x, beta, y, idx_y, desc_a, info)
      import :: psb_@X@_vect_type, psb_@X@_multivect_type, &
              & psb_desc_type, @FKIND@, psb_ipk_
      @TYPE@(@FKIND@), intent(in)                :: alpha, beta
      type(psb_@X@_vect_type), intent(inout)      :: x
      type(psb_@X@_multivect_type), intent(inout) :: y
      integer(psb_ipk_), intent(in)             :: idx_y
      type(psb_desc_type), intent(in)           :: desc_a
      integer(psb_ipk_), intent(out)            :: info
    end subroutine psb_@X@axpby_mv_v_idxs

    subroutine psb_@X@axpby_mv_m_full(alpha, x, beta, y, desc_a, info)
      import :: psb_@X@_multivect_type, psb_desc_type, &
              & @FKIND@, psb_ipk_
      @TYPE@(@FKIND@), intent(in)                :: alpha, beta
      type(psb_@X@_multivect_type), intent(inout) :: x, y
      type(psb_desc_type), intent(in)           :: desc_a
      integer(psb_ipk_), intent(out)            :: info
    end subroutine psb_@X@axpby_mv_m_full

    subroutine psb_@X@axpby_mv_m_full_out(alpha, x, beta, y, z, desc_a, info)
      import :: psb_@X@_multivect_type, psb_desc_type, &
              & @FKIND@, psb_ipk_
      type(psb_@X@_multivect_type), intent(inout) :: x, y, z
      @TYPE@(@FKIND@), intent(in)                :: alpha, beta
      type(psb_desc_type), intent(in)           :: desc_a
      integer(psb_ipk_), intent(out)            :: info
    end subroutine psb_@X@axpby_mv_m_full_out

    subroutine psb_@X@axpby_mv_m_idxs(alpha, x, idx_x, beta, y, idx_y, desc_a, info)
      import :: psb_@X@_multivect_type, psb_desc_type, &
              & @FKIND@, psb_ipk_
      @TYPE@(@FKIND@), intent(in)                :: alpha, beta
      type(psb_@X@_multivect_type), intent(inout) :: x, y
      integer(psb_ipk_), intent(in)             :: idx_x, idx_y
      type(psb_desc_type), intent(in)           :: desc_a
      integer(psb_ipk_), intent(out)            :: info
    end subroutine psb_@X@axpby_mv_m_idxs

    subroutine psb_@X@axpby_mv_vv(alpha, x, beta, y, gamma, z, idx_z, desc_a, info)
      import :: psb_desc_type, @FKIND@, psb_ipk_, &
              & psb_@X@_vect_type, psb_@X@_multivect_type
      @TYPE@(@FKIND@), intent(in)                :: alpha, beta, gamma
      type(psb_@X@_vect_type), intent(inout)      :: x, y
      type(psb_@X@_multivect_type), intent(inout) :: z
      integer(psb_ipk_), intent(in)             :: idx_z
      type(psb_desc_type), intent(in)           :: desc_a
      integer(psb_ipk_), intent(out)            :: info
    end subroutine psb_@X@axpby_mv_vv

    subroutine psb_@X@axpby_mv_mv(alpha, x, beta, y, idx_y, gamma, z, idx_z, desc_a, info)
      import :: psb_@X@_vect_type, psb_@X@_multivect_type, &
              & psb_desc_type, @FKIND@, psb_ipk_
      @TYPE@(@FKIND@), intent(in)                :: alpha, beta, gamma
      type(psb_@X@_vect_type), intent(inout)      :: x
      type(psb_@X@_multivect_type), intent(inout) :: y, z
      integer(psb_ipk_), intent(in)             :: idx_y, idx_z
      type(psb_desc_type), intent(in)           :: desc_a
      integer(psb_ipk_), intent(out)            :: info
    end subroutine psb_@X@axpby_mv_mv

    subroutine psb_@X@axpby_mv_mm_idxs(alpha, x, idx_x, beta, y, idx_y, gamma, z, idx_z, desc_a, info)
      import :: psb_desc_type, @FKIND@, psb_ipk_, &
              & psb_@X@_multivect_type
      @TYPE@(@FKIND@), intent(in)                :: alpha, beta, gamma
      type(psb_@X@_multivect_type), intent(inout) :: x, y, z
      integer(psb_ipk_), intent(in)             :: idx_x, idx_y, idx_z
      type(psb_desc_type), intent(in)           :: desc_a
      integer(psb_ipk_), intent(out)            :: info
    end subroutine psb_@X@axpby_mv_mm_idxs

    subroutine psb_@X@axpby_mv_mm_full(alpha, x, beta, y, gamma, z, desc_a, info)
      import :: psb_@X@_multivect_type, psb_desc_type, &
              & @FKIND@, psb_ipk_
      @TYPE@(@FKIND@), intent(in)                :: alpha, beta, gamma
      type(psb_@X@_multivect_type), intent(inout) :: x, y, z
      type(psb_desc_type), intent(in)           :: desc_a
      integer(psb_ipk_), intent(out)            :: info
    end subroutine psb_@X@axpby_mv_mm_full

    subroutine psb_@X@axpby_mv_mm_out(alpha, x, idx_x, beta, y, idx_y, gamma, z, idx_z, w, idx_w, desc_a, info)
      import :: psb_@X@_multivect_type, psb_desc_type, &
              & @FKIND@, psb_ipk_
      @TYPE@(@FKIND@), intent(in)                :: alpha, beta, gamma
      type(psb_@X@_multivect_type), intent(inout) :: x, y, z, w
      integer(psb_ipk_), intent(in)             :: idx_x, idx_y, idx_z, idx_w
      type(psb_desc_type), intent(in)           :: desc_a
      integer(psb_ipk_), intent(out)            :: info
    end subroutine psb_@X@axpby_mv_mm_out

    subroutine psb_@X@axpby_mv_cspan1D(x, coeff, y, desc_a, info, upd_flag)
      import :: psb_@X@_multivect_type, psb_@X@_vect_type, &
              & psb_desc_type, @FKIND@, psb_ipk_
      type(psb_@X@_multivect_type), intent(inout) :: x
      @TYPE@(@FKIND@), intent(in)                :: coeff(:)
      type(psb_@X@_vect_type), intent(inout)      :: y
      type(psb_desc_type), intent(in)           :: desc_a
      integer(psb_ipk_), intent(out)            :: info
      logical, intent(in), optional             :: upd_flag
    end subroutine psb_@X@axpby_mv_cspan1D

    subroutine psb_@X@axpby_mv_cspan2D(x, coeff, y, desc_a, info, upd_flag)
      import :: psb_desc_type, @FKIND@, psb_ipk_, &
              & psb_@X@_multivect_type
      type(psb_@X@_multivect_type), intent(inout) :: x, y
      @TYPE@(@FKIND@), intent(in)                :: coeff(:, :)
      type(psb_desc_type), intent(in)           :: desc_a
      integer(psb_ipk_), intent(out)            :: info
      logical, intent(in), optional             :: upd_flag
    end subroutine psb_@X@axpby_mv_cspan2D

    subroutine psb_@X@axpby_vect_out(alpha, x, beta, y, z, desc_a, info)
      import :: psb_@X@_vect_type, psb_desc_type, &
              & @FKIND@, psb_ipk_
      @TYPE@(@FKIND@), intent(in)            :: alpha, beta
      type(psb_@X@_vect_type), intent(inout)  :: x, y, z
      type(psb_desc_type), intent(in)       :: desc_a
      integer(psb_ipk_), intent(out)        :: info
    end subroutine psb_@X@axpby_vect_out
    
    subroutine psb_@X@axpbyv(alpha, x, beta, y, desc_a, info)
      import :: psb_desc_type, @FKIND@, psb_ipk_
      @TYPE@(@FKIND@), intent(in)      :: alpha, beta
      @TYPE@(@FKIND@), intent(in)      :: x(:)
      @TYPE@(@FKIND@), intent(inout)   :: y(:)
      type(psb_desc_type), intent(in) :: desc_a
      integer(psb_ipk_), intent(out)  :: info
    end subroutine psb_@X@axpbyv
    
    subroutine psb_@X@axpbyvout(alpha, x, beta, y, z, desc_a, info)
      import :: psb_desc_type, @FKIND@, psb_ipk_
      @TYPE@(@FKIND@), intent(in)      :: alpha, beta
      @TYPE@(@FKIND@), intent(in)      :: x(:), y(:)
      @TYPE@(@FKIND@), intent(inout)   :: z(:)
      type(psb_desc_type), intent(in) :: desc_a
      integer(psb_ipk_), intent(out)  :: info
    end subroutine psb_@X@axpbyvout
    
    subroutine psb_@X@axpby(alpha, x, beta, y, desc_a, info, n, jx, jy)
      import :: psb_desc_type, @FKIND@, psb_ipk_
      @TYPE@(@FKIND@), intent(in)      :: alpha, beta
      @TYPE@(@FKIND@), intent(in)      :: x(:, :)
      @TYPE@(@FKIND@), intent(inout)   :: y(:, :)
      type(psb_desc_type), intent(in) :: desc_a
      integer(psb_ipk_), intent(out)  :: info
      integer(psb_ipk_), optional, intent(in) :: n, jx, jy
    end subroutine psb_@X@axpby
  end interface

  interface psb_upd_xyz
    subroutine psb_@X@_upd_xyz_vect(alpha, beta, gamma, delta, x, y, z, &
                                & desc_a, info)
      import :: psb_@X@_vect_type, psb_desc_type, @FKIND@, psb_ipk_
      @TYPE@(@FKIND@), intent(in)            :: alpha, beta, gamma, delta
      type(psb_@X@_vect_type), intent(inout)  :: x, y, z
      type(psb_desc_type), intent(in)       :: desc_a
      integer(psb_ipk_), intent(out)        :: info
    end subroutine psb_@X@_upd_xyz_vect
  end interface psb_upd_xyz
  
  interface psb_geamax
    function psb_@X@amax(x, desc_a, info, jx, global)
      import :: psb_desc_type, @FKIND@, psb_ipk_
      @TYPE@(@FKIND@), intent(in)      :: x(:, :)
      type(psb_desc_type), intent(in) :: desc_a
      integer(psb_ipk_), intent(out)  :: info
      integer(psb_ipk_), optional, intent(in) :: jx
      logical, intent(in), optional           :: global
      @RTYPE@(@FKIND@)  :: psb_@X@amax
    end function psb_@X@amax

    function psb_@X@amaxv(x, desc_a, info, global)
      import :: psb_desc_type, @FKIND@, psb_ipk_
      @TYPE@(@FKIND@), intent(in)      :: x(:)
      type(psb_desc_type), intent(in) :: desc_a
      integer(psb_ipk_), intent(out)  :: info
      logical, intent(in), optional :: global
      @RTYPE@(@FKIND@)  :: psb_@X@amaxv
    end function psb_@X@amaxv

    function psb_@X@amax_vect(x, desc_a, info, global) result(res)
      import :: psb_desc_type, psb_@X@_vect_type, @FKIND@, psb_ipk_
      type(psb_@X@_vect_type), intent(inout)  :: x
      type(psb_desc_type), intent(in)       :: desc_a
      integer(psb_ipk_), intent(out)        :: info
      logical, intent(in), optional :: global
      @RTYPE@(@FKIND@)  :: res
    end function psb_@X@amax_vect
  end interface

#if !defined(PSB_HAVE_BUGGY_GENERICS)
  interface psb_genrmi
    procedure psb_@X@amax, psb_@X@amaxv, psb_@X@amax_vect
  end interface

  interface psb_normi
    procedure psb_@X@amax, psb_@X@amaxv, psb_@X@amax_vect
  end interface
#endif

  interface psb_geamaxs
    subroutine psb_@X@amaxvs(res, x, desc_a, info, global)
      import :: psb_desc_type, @FKIND@, psb_ipk_
      @RTYPE@(@FKIND@), intent(out)     :: res
      @TYPE@(@FKIND@), intent(in)      :: x(:)
      type(psb_desc_type), intent(in) :: desc_a
      integer(psb_ipk_), intent(out)  :: info
      logical, intent(in), optional :: global
    end subroutine psb_@X@amaxvs

    subroutine psb_@X@mamaxs(res, x, desc_a, info, jx, global)
      import :: psb_desc_type, @FKIND@, psb_ipk_
      @RTYPE@(@FKIND@), intent(out)     :: res(:)
      @TYPE@(@FKIND@), intent(in)      :: x(:, :)
      type(psb_desc_type), intent(in) :: desc_a
      integer(psb_ipk_), intent(out)  :: info
      integer(psb_ipk_), optional, intent(in) :: jx
      logical, intent(in), optional           :: global
    end subroutine psb_@X@mamaxs
  end interface

  @NOTCPLXS@
  interface psb_gemin
    function psb_@X@min_vect(x, desc_a, info, global) result(res)
      import :: psb_@X@_vect_type, psb_desc_type, @FKIND@, psb_ipk_
      type(psb_@X@_vect_type), intent(inout)  :: x
      type(psb_desc_type), intent(in)       :: desc_a
      integer(psb_ipk_), intent(out)        :: info
      logical, intent(in), optional :: global
      @RTYPE@(@FKIND@)  :: res
    end function psb_@X@min_vect
  end interface
  @NOTCPLXE@

  interface psb_geasum
    function psb_@X@asum(x, desc_a, info, jx, global)
      import :: psb_desc_type, @FKIND@, psb_ipk_
      @TYPE@(@FKIND@), intent(in)      :: x(:, :)
      type(psb_desc_type), intent(in) :: desc_a
      integer(psb_ipk_), intent(out)  :: info
      integer(psb_ipk_), optional, intent(in) :: jx
      logical, intent(in), optional           :: global
      @RTYPE@(@FKIND@)  :: psb_@X@asum
    end function psb_@X@asum

    function psb_@X@asumv(x, desc_a, info, global)
      import :: psb_desc_type, @FKIND@, psb_ipk_
      @TYPE@(@FKIND@), intent(in)      :: x(:)
      type(psb_desc_type), intent(in) :: desc_a
      integer(psb_ipk_), intent(out)  :: info
      logical, intent(in), optional :: global
      @RTYPE@(@FKIND@)  :: psb_@X@asumv
    end function psb_@X@asumv
  
    function psb_@X@asum_vect(x, desc_a, info, global) result(res)
      import :: psb_@X@_vect_type, psb_desc_type, @FKIND@, psb_ipk_
      type(psb_@X@_vect_type), intent(inout)  :: x
      type(psb_desc_type), intent(in)       :: desc_a
      integer(psb_ipk_), intent(out)        :: info
      logical, intent(in), optional :: global
      @RTYPE@(@FKIND@)  :: res
    end function psb_@X@asum_vect
  end interface

  interface psb_geasums
    subroutine psb_@X@asumvs(res, x, desc_a, info, global)
      import :: psb_desc_type, @FKIND@, psb_ipk_
      @RTYPE@(@FKIND@), intent(out)     :: res
      @TYPE@(@FKIND@), intent(in)      :: x(:)
      type(psb_desc_type), intent(in) :: desc_a
      integer(psb_ipk_), intent(out)  :: info
      logical, intent(in), optional :: global
    end subroutine psb_@X@asumvs

    subroutine psb_@X@masum(res, x, desc_a, info, global)
      import :: psb_desc_type, @FKIND@, psb_ipk_
      @RTYPE@(@FKIND@), intent(out)     :: res(:)
      @TYPE@(@FKIND@), intent(in)      :: x(:, :)
      type(psb_desc_type), intent(in) :: desc_a
      integer(psb_ipk_), intent(out)  :: info
      logical, intent(in), optional :: global
    end subroutine psb_@X@masum
  end interface

#if !defined(PSB_HAVE_BUGGY_GENERICS)
  interface psb_genrm1
    procedure psb_@X@asum, psb_@X@asumv, psb_@X@asum_vect
