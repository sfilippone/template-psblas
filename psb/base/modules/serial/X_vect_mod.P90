  subroutine @X@_vect_div_a2_check(x, y, z, info, flag)
    use psi_serial_mod
    implicit none
    @TYPE@(@FKIND@), intent(in)           :: x(:), y(:)
    class(psb_@X@_vect_type), intent(inout) :: z
    integer(psb_ipk_), intent(out)        :: info

    integer(psb_ipk_) :: i, n
    logical, intent(in) :: flag

    info = psb_success_
    if(allocated(z%v)) call z%v%div(x, y, info, flag)
  end subroutine @X@_vect_div_a2_check

  subroutine @X@_vect_inv_v(x, y, info)
    use psi_serial_mod
    implicit none
    class(psb_@X@_vect_type), intent(inout) :: x
    class(psb_@X@_vect_type), intent(inout) :: y
    integer(psb_ipk_), intent(out)        :: info

    integer(psb_ipk_) :: i, n

    info = psb_success_
    if(allocated(x%v) .and. allocated(y%v)) call y%v%inv(x%v, info)
  end subroutine @X@_vect_inv_v

  subroutine @X@_vect_inv_v_check(x, y, info, flag)
    use psi_serial_mod
    implicit none
    class(psb_@X@_vect_type), intent(inout) :: x, y
    integer(psb_ipk_), intent(out)        :: info

    integer(psb_ipk_) :: i, n
    logical, intent(in) :: flag

    info = psb_success_
    if(allocated(x%v) .and. allocated(y%v)) call y%v%inv(x%v, info, flag)
  end subroutine @X@_vect_inv_v_check

  subroutine @X@_vect_inv_a2(x, y, info)
    use psi_serial_mod
    implicit none
    @TYPE@(@FKIND@), intent(inout)         :: x(:)
    class(psb_@X@_vect_type), intent(inout) :: y
    integer(psb_ipk_), intent(out)        :: info

    integer(psb_ipk_) :: i, n

    info = psb_success_
    if(allocated(y%v)) call y%v%inv(x, info)
  end subroutine @X@_vect_inv_a2

  subroutine @X@_vect_inv_a2_check(x, y, info, flag)
    use psi_serial_mod
    implicit none
    @TYPE@(@FKIND@), intent(inout)         :: x(:)
    class(psb_@X@_vect_type), intent(inout) :: y
    integer(psb_ipk_), intent(out)        :: info

    integer(psb_ipk_) :: i, n
    logical, intent(in) :: flag

    info = psb_success_
    if(allocated(y%v)) call y%v%inv(x, info, flag)
  end subroutine @X@_vect_inv_a2_check

  subroutine @X@_vect_acmp_a2(x, c, z, info)
    use psi_serial_mod
    implicit none
    @TYPE@(@FKIND@), intent(inout)         :: x(:)
    @RTYPE@(@FKIND@), intent(in)            :: c
    class(psb_@X@_vect_type), intent(inout) :: z
    integer(psb_ipk_), intent(out)        :: info

    info = psb_success_
    if(allocated(z%v)) call z%acmp(x, c, info)
  end subroutine @X@_vect_acmp_a2

  subroutine @X@_vect_acmp_v2(x, c, z, info)
    use psi_serial_mod
    implicit none
    @RTYPE@(@FKIND@), intent(in)            :: c
    class(psb_@X@_vect_type), intent(inout) :: x
    class(psb_@X@_vect_type), intent(inout) :: z
    integer(psb_ipk_), intent(out)         :: info

    info = psb_success_
    if(allocated(x%v) .and. allocated(z%v)) call z%v%acmp(x%v, c, info)
  end subroutine @X@_vect_acmp_v2

  subroutine @X@_vect_scal(alpha, x)
    use psi_serial_mod
    implicit none
    @TYPE@(@FKIND@), intent(in)            :: alpha
    class(psb_@X@_vect_type), intent(inout) :: x

    if(allocated(x%v)) call x%v%scal(alpha)
  end subroutine @X@_vect_scal

  subroutine @X@_vect_absval1(x)
    class(psb_@X@_vect_type), intent(inout)  :: x

    if(allocated(x%v)) call x%v%absval()
  end subroutine @X@_vect_absval1

  subroutine @X@_vect_absval2(x, y)
    class(psb_@X@_vect_type), intent(inout) :: x, y

    if(allocated(x%v)) then
      if(.not. allocated(y%v)) call y%bld(psb_size(x%v%v))
      call x%v%absval(y%v)
    end if
  end subroutine @X@_vect_absval2

  function @X@_vect_nrm2(n, x) result(res)
    implicit none
    integer(psb_ipk_), intent(in)         :: n
    class(psb_@X@_vect_type), intent(inout) :: x
    @RTYPE@(@FKIND@)  :: res

    res = @RZERO@
    if(allocated(x%v)) res = x%v%nrm2(n)
  end function @X@_vect_nrm2

  function @X@_vect_nrm2_weight(n, x, w, aux) result(res)
    use psi_serial_mod
    implicit none
    integer(psb_ipk_), intent(in)         :: n
    class(psb_@X@_vect_type), intent(inout) :: x
    class(psb_@X@_vect_type), intent(inout) :: w
    class(psb_@X@_vect_type), intent(inout), optional :: aux
    @RTYPE@(@FKIND@)  :: res

    integer(psb_ipk_) :: info
    ! Temp vectors
    type(psb_@X@_vect_type) :: wtemp

    info = psb_success_
    if(allocated(w%v)) then
      if(.not. present(aux)) then
        allocate(wtemp%v, mold = w%v)
        call wtemp%v%bld(w%get_vect())
      else
        call psb_geaxpby(n, @XONE@, w%v%v, @XZERO@, aux%v%v, info)
      end if
    else
      info = -1
    end if
    if(info /= psb_success_) then
      res = -@RONE@
      return
    end if

    if(allocated(x%v)) then
      if(.not. present(aux)) then
        call wtemp%v%mlt(x%v, info)
        res = wtemp%v%nrm2(n)
      else
        call aux%v%mlt(x%v, info)
        res = aux%v%nrm2(n)
      end if
    else
      res = @RZERO@
    end if

    if(.not. present(aux)) call wtemp%free(info)
  end function @X@_vect_nrm2_weight
 
  function @X@_vect_nrm2_weight_mask(n, x, w, id, info, aux) result(res)
    use psi_serial_mod
    implicit none
    integer(psb_ipk_), intent(in)         :: n
    class(psb_@X@_vect_type), intent(inout) :: x
    class(psb_@X@_vect_type), intent(inout) :: w, id
    integer(psb_ipk_), intent(out)        :: info
    class(psb_@X@_vect_type), intent(inout), optional :: aux
    @RTYPE@(@FKIND@)  :: res

    ! Temp vectors
    type(psb_@X@_vect_type) :: wtemp

    info = psb_success_ 
    if( allocated(w%v) ) then
      if(.not. present(aux)) then
        allocate(wtemp%v, mold = w%v)
        call wtemp%v%bld(w%get_vect())
      else
        call psb_geaxpby(n, @XONE@, w%v%v, @XZERO@, aux%v%v, info)
      end if
    else
      info = -1
    end if
    if(info /= psb_success_) then
      res = -@RONE@
      return
    end if

    if(allocated(x%v) .and. allocated(id%v)) then
      if(.not. present(aux)) then
        where(abs(id%v%v) <= @RZERO@) wtemp%v%v = @RZERO@
        call wtemp%set_host()
        call wtemp%v%mlt(x%v, info)
        res = wtemp%v%nrm2(n)
      else
        where(abs(id%v%v) <= @RZERO@) aux%v%v = @RZERO@
        call aux%set_host()
        call aux%v%mlt(x%v, info)
        res = aux%v%nrm2(n)
      end if
    else
      res = @RZERO@
    end if

    if(.not. present(aux)) call wtemp%free(info)
  end function @X@_vect_nrm2_weight_mask

  function @X@_vect_amax(n, x) result(res)
    implicit none
    integer(psb_ipk_), intent(in)         :: n
    class(psb_@X@_vect_type), intent(inout) :: x
    @RTYPE@(@FKIND@)  :: res

    res = @RZERO@
    if(allocated(x%v)) res = x%v%amax(n)
  end function @X@_vect_amax

  @NOTCPLXS@
  function @X@_vect_min(n, x) result(res)
    implicit none
    integer(psb_ipk_), intent(in)         :: n
    class(psb_@X@_vect_type), intent(inout) :: x
    @RTYPE@(@FKIND@)  :: res

    res = HUGE(@RONE@)
    if(allocated(x%v)) res = x%v%minreal(n)
  end function @X@_vect_min
  @NOTCPLXE@

  function @X@_vect_asum(n, x) result(res)
    implicit none
    class(psb_@X@_vect_type), intent(inout) :: x
    integer(psb_ipk_), intent(in)           :: n
    @RTYPE@(@FKIND@)  :: res
    
    res = @RZERO@
    if(allocated(x%v)) res = x%v%asum(n)
  end function @X@_vect_asum
  @NOTINTE@

  @NOTINTS@
  @NOTCPLXS@
  subroutine @X@_vect_mask_a(c, x, m, t, info)
    use psi_serial_mod
    implicit none
    @RTYPE@(@FKIND@), intent(inout)        :: c(:)
    @RTYPE@(@FKIND@), intent(inout)        :: x(:)
    class(psb_@X@_vect_type), intent(inout) :: m
    logical, intent(out)                  :: t
    integer(psb_ipk_), intent(out)        :: info

    info = psb_success_
    if(allocated(m%v)) call m%mask(c, x, t, info)
  end subroutine @X@_vect_mask_a

  subroutine @X@_vect_mask_v(c, x, m, t, info)
    use psi_serial_mod
    implicit none
    class(psb_@X@_vect_type), intent(inout) :: c
    class(psb_@X@_vect_type), intent(inout) :: x
    class(psb_@X@_vect_type), intent(inout) :: m
    logical, intent(out)                  :: t;
    integer(psb_ipk_), intent(out)        :: info

    info = psb_success_
    if(allocated(x%v) .and. allocated(c%v)) call m%v%mask(x%v, c%v, t, info)
  end subroutine @X@_vect_mask_v

  function @X@_vect_minquotient_v(x, y, info) result(z)
    use psi_serial_mod
    implicit none
    class(psb_@X@_vect_type), intent(inout) :: x
    class(psb_@X@_vect_type), intent(inout) :: y
    integer(psb_ipk_), intent(out)        :: info
    @RTYPE@(@FKIND@)  :: z

    info = psb_success_
    if(allocated(x%v) .and. allocated(y%v)) z = x%v%minquotient(y%v, info)
  end function @X@_vect_minquotient_v

  function @X@_vect_minquotient_a2(x, y, info) result(z)
    use psi_serial_mod
    implicit none
    class(psb_@X@_vect_type), intent(inout) :: x
    @TYPE@(@FKIND@), intent(inout)         :: y(:)
    integer(psb_ipk_), intent(out)       :: info
    @RTYPE@(@FKIND@)  :: z

    info = psb_success_
    z = x%v%minquotient(y, info)
  end function @X@_vect_minquotient_a2
  @NOTINTE@
  @NOTCPLXE@

  @NOTINTS@
  subroutine @X@_vect_addconst_a2(x, b, z, info)
    use psi_serial_mod
    implicit none
    @TYPE@(@FKIND@), intent(inout)         :: x(:)
    @RTYPE@(@FKIND@), intent(in)           :: b
    class(psb_@X@_vect_type), intent(inout) :: z
    integer(psb_ipk_), intent(out)        :: info

    info = psb_success_
    if(allocated(z%v)) call z%addconst(x, b, info)
  end subroutine @X@_vect_addconst_a2

  subroutine @X@_vect_addconst_v2(x, b, z, info)
    use psi_serial_mod
    implicit none
    class(psb_@X@_vect_type), intent(inout) :: x
    @RTYPE@(@FKIND@), intent(in)           :: b
    class(psb_@X@_vect_type), intent(inout) :: z
    integer(psb_ipk_), intent(out)        :: info

    info = psb_success_
    if(allocated(x%v) .and. allocated(z%v)) call z%v%addconst(x%v, b, info)
  end subroutine @X@_vect_addconst_v2
  @NOTINTE@
end module psb_@X@_vect_mod


module psb_@X@_multivect_mod
  use psb_@X@_base_multivect_mod
  use psb_const_mod
  use psb_i_vect_mod

  !private
  type psb_@X@_multivect_type
    class(psb_@X@_base_multivect_type), allocatable :: v
    integer(psb_ipk_) :: nrmv = 0
    integer(psb_ipk_) :: remote_build = psb_matbld_noremote_
    @TYPE@(@FKIND@), allocatable :: rmtv(:, :)
  contains
    procedure, pass(x) :: get_nrows => @X@_mvect_get_nrows
    procedure, pass(x) :: get_ncols => @X@_mvect_get_ncols
    procedure, pass(x) :: sizeof   => @X@_mvect_sizeof
    procedure, pass(x) :: get_fmt  => @X@_mvect_get_fmt
    procedure, pass(x) :: is_remote_build => @X@_mvect_is_remote_build
    procedure, pass(x) :: set_remote_build => @X@_mvect_set_remote_build

    procedure, pass(x) :: all      => @X@_mvect_all
    procedure, pass(x) :: reall    => @X@_mvect_reall
    procedure, pass(x) :: zero     => @X@_mvect_zero
    procedure, pass(x) :: asb      => @X@_mvect_asb
    procedure, pass(x) :: sync     => @X@_mvect_sync
    procedure, pass(x) :: free     => @X@_mvect_free
    procedure, pass(x) :: reinit   => @X@_mvect_reinit
    procedure, pass(x) :: set_ncfs => @X@_mvect_set_ncfs 
    procedure, pass(x) :: get_ncfs => @X@_mvect_get_ncfs
    procedure, pass(x) :: set_dupl => @X@_mvect_set_dupl 
    procedure, pass(x) :: get_dupl => @X@_mvect_get_dupl
    procedure, pass(x) :: set_state => @X@_mvect_set_state
    procedure, pass(x) :: set_null  => @X@_mvect_set_null
    procedure, pass(x) :: set_bld   => @X@_mvect_set_bld
    procedure, pass(x) :: set_upd   => @X@_mvect_set_upd
    procedure, pass(x) :: set_asb   => @X@_mvect_set_asb
    procedure, pass(x) :: get_state => @X@_mvect_get_state
    procedure, pass(x) :: is_null   => @X@_mvect_is_null
    procedure, pass(x) :: is_bld    => @X@_mvect_is_bld
    procedure, pass(x) :: is_upd    => @X@_mvect_is_upd
    procedure, pass(x) :: is_asb    => @X@_mvect_is_asb
    !!$ procedure, pass(x) :: base_cpy  => @X@_mvect_cpy

    procedure, pass(x) :: ins      => @X@_mvect_ins
    procedure, pass(x) :: bld_x    => @X@_mvect_bld_x
    procedure, pass(x) :: bld_n    => @X@_mvect_bld_n
    generic, public    :: bld      => bld_x, bld_n
    procedure, pass(x) :: get_vect => @X@_mvect_get_vect
    procedure, pass(x) :: cnv      => @X@_mvect_cnv

    procedure, pass(x) :: set_scal => @X@_mvect_set_scal
    procedure, pass(x) :: set_vect => @X@_mvect_set_vect
    @INTS@
    generic, public    :: set      => set_vect, set_scal
    @INTE@
    @NOTINTS@
    procedure, pass(x) :: set_colm => @X@_mvect_set_colm
    generic, public    :: set      => set_vect, set_scal, set_colm
    @NOTINTE@

    procedure, pass(x) :: clone    => @X@_mvect_clone
    procedure, pass(x) :: gthab    => @X@_mvect_gthab
    procedure, pass(x) :: gthzv    => @X@_mvect_gthzv
    procedure, pass(x) :: gthzv_x  => @X@_mvect_gthzv_x
    generic, public    :: gth      => gthab, gthzv
    procedure, pass(y) :: sctb     => @X@_mvect_sctb
    procedure, pass(y) :: sctb_x   => @X@_mvect_sctb_x
    generic, public    :: sct      => sctb, sctb_x

    @NOTINTS@
    ! single column export as vector
    procedure, pass(x) :: extract_col   => @X@_mvect_extract_col
    ! two term axpy-like operations
    procedure, pass(y) :: axpby_v_i     => @X@_mvect_axpby_v_idxs
    procedure, pass(y) :: axpby_v_f     => @X@_mvect_axpby_v_full
    procedure, pass(y) :: axpby_m_i     => @X@_mvect_axpby_m_idxs
    procedure, pass(y) :: axpby_m_f     => @X@_mvect_axpby_m_full
    ! two term axpy-like operations with separate output mv
    procedure, pass(z) :: axpby_m_f_o   => @X@_mvect_axpby_m_full_out
    ! three term axpy-like operations
    procedure, pass(z) :: axpbycz_vv    => @X@_mvect_axpbycz_vv
    procedure, pass(z) :: axpbycz_mv    => @X@_mvect_axpbycz_mv
    procedure, pass(z) :: axpbycz_mm_i  => @X@_mvect_axpbycz_mm_idxs
    procedure, pass(z) :: axpbycz_mm_f  => @X@_mvect_axpbycz_mm_full
    ! three term axpy-like operations with separate output mv (rename?)
    procedure, pass(w) :: axpbycz_mm_o  => @X@_mvect_axpbycz_mm_out
    ! linear combinations of columns of the multivector
    procedure, pass(x) :: colspan1D     => @X@_mvect_colspan1D
    procedure, pass(x) :: colspan2D     => @X@_mvect_colspan2D
    ! all procedures exported as axpby
    generic, public    :: axpby         => extract_col, &
                                            axpby_v_i, axpby_v_f, & 
                                            axpby_m_i, axpby_m_f, &
                                            axpby_m_f_o, &
                                            axpbycz_vv, axpbycz_mv, axpbycz_mm_i, &
                                            axpbycz_mm_f, axpbycz_mm_o, & 
                                            colspan1D, colspan2D

    ! dot products operations - only full-full version for now
    procedure, pass(x) :: dot_mm  => @X@_mvect_dot_mm
    procedure, pass(x) :: dot_mv  => @X@_mvect_dot_mv
    generic, public    :: dot     => dot_mm, dot_mv

    ! Element wise multiplication operations with in place output
    procedure, pass(y) :: mlt_v_f     => @X@_mvect_mlt_v_full
    procedure, pass(y) :: mlt_v_i     => @X@_mvect_mlt_v_idxs
    procedure, pass(y) :: mlt_m_f     => @X@_mvect_mlt_m_full
    procedure, pass(y) :: mlt_m_i     => @X@_mvect_mlt_m_idxs
    ! Element wise multiplication operations with separate output
    procedure, pass(z) :: mlt_vv_f_o  => @X@_mvect_mlt_vv_full_out
    procedure, pass(z) :: mlt_vv_i_o  => @X@_mvect_mlt_vv_idxs_out
    procedure, pass(z) :: mlt_vm_f_o  => @X@_mvect_mlt_vm_full_out
    procedure, pass(z) :: mlt_vm_i_o  => @X@_mvect_mlt_vm_idxs_out
    procedure, pass(z) :: mlt_mm_f_o  => @X@_mvect_mlt_mm_full_out
    procedure, pass(z) :: mlt_mm_i_o  => @X@_mvect_mlt_mm_idxs_out
    ! Element wise multiplication operations with externel vector output
    procedure, pass(y) :: mlt_vm_e    => @X@_mvect_mlt_vm_ext
    procedure, pass(y) :: mlt_mm_e    => @X@_mvect_mlt_mm_ext
    ! All procedures exported as mlt
    generic, public    :: mlt         => mlt_v_f, mlt_v_i, &
                                          mlt_m_f, mlt_m_i, &
                                          mlt_vv_f_o, mlt_vv_i_o, &
                                          mlt_vm_f_o, mlt_vm_i_o, &
                                          mlt_mm_f_o, mlt_mm_i_o, &
                                          mlt_vm_e, mlt_mm_e
    !
    ! Scaling and norms
    !
    procedure, pass(x)  :: nrm2_f => @X@_mvect_nrm2_full
    procedure, pass(x)  :: nrm2_i => @X@_mvect_nrm2_idxs
    generic, public     :: nrm2   => nrm2_f, nrm2_i
    
    !!$ procedure, pass(x) :: scal     => @X@_mvect_scal
    !!$ procedure, pass(x) :: amax     => @X@_mvect_amax
    !!$ procedure, pass(x) :: asum     => @X@_mvect_asum
    @NOTINTE@
  end type psb_@X@_multivect_type

  public  :: psb_@X@_multivect, psb_@X@_multivect_type, psb_@X@_base_multivect_type, &
          & psb_set_multivect_default, psb_get_multivect_default

  private
  interface psb_@X@_multivect
    module procedure constructor, size_const
  end interface psb_@X@_multivect

  class(psb_@X@_base_multivect_type), allocatable, target, &
       & save, private :: psb_@X@_base_multivect_default

  interface psb_set_multivect_default
    module procedure psb_@X@_set_multivect_default
  end interface psb_set_multivect_default

  interface psb_get_multivect_default
    module procedure psb_@X@_get_multivect_default
  end interface psb_get_multivect_default

contains
  function @X@_mvect_is_remote_build(x) result(res)
    implicit none
    class(psb_@X@_multivect_type), intent(in) :: x
    logical :: res
    
    res = (x%remote_build == psb_matbld_remote_)
  end function @X@_mvect_is_remote_build

  subroutine @X@_mvect_set_remote_build(x, val)
    implicit none
    class(psb_@X@_multivect_type), intent(inout) :: x
    integer(psb_ipk_), intent(in), optional :: val

    if(present(val)) then
      x%remote_build = val
    else
      x%remote_build = psb_matbld_remote_
    end if
  end subroutine @X@_mvect_set_remote_build

  subroutine psb_@X@_set_multivect_default(v)
    implicit none
    class(psb_@X@_base_multivect_type), intent(in) :: v

    if(allocated(psb_@X@_base_multivect_default)) then
      deallocate(psb_@X@_base_multivect_default)
    end if
    allocate(psb_@X@_base_multivect_default, mold = v)
  end subroutine psb_@X@_set_multivect_default

  function psb_@X@_get_multivect_default(v) result(res)
    implicit none
    class(psb_@X@_multivect_type), intent(in) :: v
    class(psb_@X@_base_multivect_type), pointer :: res

    res => psb_@X@_get_base_multivect_default()
  end function psb_@X@_get_multivect_default

  function psb_@X@_get_base_multivect_default() result(res)
    implicit none
    class(psb_@X@_base_multivect_type), pointer :: res

    if(.not. allocated(psb_@X@_base_multivect_default)) then
      allocate(psb_@X@_base_multivect_type :: psb_@X@_base_multivect_default)
    end if

    res => psb_@X@_base_multivect_default
  end function psb_@X@_get_base_multivect_default

  subroutine @X@_mvect_clone(x, y, info)
    implicit none
    class(psb_@X@_multivect_type), intent(inout)  :: x, y
    integer(psb_ipk_), intent(out)                :: info

    info = psb_success_
    call y%free(info)
    if((info == psb_success_) .and. allocated(x%v)) then
      call y%bld_x(x%get_vect(), mold = x%v)
    end if
  end subroutine @X@_mvect_clone

