  subroutine @X@_mvect_all(m, n, x, info, mold)
    implicit none
    integer(psb_ipk_), intent(in)             :: m, n
    class(psb_@X@_multivect_type), intent(out)  :: x
    integer(psb_ipk_), intent(out)            :: info
    class(psb_@X@_base_multivect_type), intent(in), optional :: mold

    if(present(mold)) then
      allocate(x%v, stat = info, mold = mold)
    else
      allocate(psb_@X@_base_multivect_type :: x%v, stat = info)
    endif
    if(info == psb_success_) then
      call x%v%all(m, n, info)
    else
      info = psb_err_alloc_dealloc_
    end if
    call x%set_bld()
  end subroutine @X@_mvect_all

  subroutine @X@_mvect_reall(m, n, x, info)
    implicit none
    integer(psb_ipk_), intent(in)               :: m, n
    class(psb_@X@_multivect_type), intent(inout)  :: x
    integer(psb_ipk_), intent(out)              :: info

    info = psb_success_
    if(.not. allocated(x%v)) call x%all(m, n, info)
    if(info == psb_success_) call x%asb(m, n, info)
  end subroutine @X@_mvect_reall

