    if(.not. allocated(z%v)) then
      info = psb_err_invalid_vect_state_
      return
    end if

    if((idx_y < 0) .or. (idx_x < 0)) then
      info = psb_err_iarg_neg_
      return
    endif

    if((idx_y > y%get_ncols()) .or. (idx_x > x%get_ncols())) then
      info = psb_err_entry_out_of_bounds_
      return
    endif

    call y%v%mlt(m, alpha, x%v, idx_x, idx_y, beta, z%v, info, conjgx, conjgy)
  end subroutine @X@_mvect_mlt_mm_ext

  function @X@_mvect_nrm2_full(m, x) result(res)
    implicit none
    integer(psb_ipk_), intent(in)               :: m
    class(psb_@X@_multivect_type), intent(inout)  :: x
    @RTYPE@(@FKIND@), allocatable :: res(:)

    if(.not. allocated(x%v)) then
      res = @RZERO@
      return
    end if
    
    res = x%v%nrm2(m)
  end function @X@_mvect_nrm2_full
  
  function @X@_mvect_nrm2_idxs(m, x, idx) result(res)
    implicit none
    integer(psb_ipk_), intent(in)               :: m
    class(psb_@X@_multivect_type), intent(inout)  :: x
    integer(psb_ipk_), intent(in)               :: idx
    @RTYPE@(@FKIND@)  :: res

    if(.not. allocated(x%v)) then
      res = @RZERO@
      return
    end if
    
    res = x%v%nrm2(m, idx)
  end function @X@_mvect_nrm2_idxs

