      info = psb_err_entry_out_of_bounds_
      return
    endif

    call z%v%mlt(m, alpha, x%v, idx_x, y%v, idx_y, beta, idx_z, info, conjgx, conjgy)
  end subroutine @X@_mvect_mlt_mm_idxs_out
  
