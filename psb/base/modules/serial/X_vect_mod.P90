!!$  module function @X@_mvect_dot_v(n,x,y) result(res)
!!$    class(psb_@X@_multivect_type), intent(inout) :: x, y
!!$    integer(psb_ipk_), intent(in)           :: n
!!$    @TYPE@(@FKIND@)                :: res
!!$
!!$    res = @XZERO@
!!$    if (allocated(x%v).and.allocated(y%v)) &
!!$         & res = x%v%dot(n,y%v)
!!$
!!$  end function @X@_mvect_dot_v
!!$
!!$  function @X@_mvect_dot_a(n,x,y) result(res)
!!$    class(psb_@X@_multivect_type), intent(inout) :: x
!!$    @TYPE@(@FKIND@), intent(in)    :: y(:)
!!$    integer(psb_ipk_), intent(in)           :: n
!!$    @TYPE@(@FKIND@)                :: res
!!$
!!$    res = @XZERO@
!!$    if (allocated(x%v)) &
!!$         & res = x%v%dot(n,y)
!!$
!!$  end function @X@_mvect_dot_a
!!$
!!$  module subroutine @X@_mvect_axpby_v(m,alpha, x, beta, y, info)
!!$    integer(psb_ipk_), intent(in)               :: m
!!$    class(psb_@X@_multivect_type), intent(inout)  :: x
!!$    class(psb_@X@_multivect_type), intent(inout)  :: y
!!$    @TYPE@(@FKIND@), intent (in)       :: alpha, beta
!!$    integer(psb_ipk_), intent(out)              :: info
!!$
!!$    if (allocated(x%v).and.allocated(y%v)) then
!!$      call y%v%axpby(m,alpha,x%v,beta,info)
!!$    else
!!$      info = psb_err_invalid_mvect_state_
!!$    end if
!!$
!!$  end subroutine @X@_mvect_axpby_v
!!$
!!$  subroutine @X@_mvect_axpby_a(m,alpha, x, beta, y, info)
!!$    integer(psb_ipk_), intent(in)               :: m
!!$    @TYPE@(@FKIND@), intent(in)        :: x(:)
!!$    class(psb_@X@_multivect_type), intent(inout)  :: y
!!$    @TYPE@(@FKIND@), intent (in)       :: alpha, beta
!!$    integer(psb_ipk_), intent(out)              :: info
!!$
!!$    if (allocated(y%v)) &
!!$         & call y%v%axpby(m,alpha,x,beta,info)
!!$
!!$  end subroutine @X@_mvect_axpby_a
!!$
!!$
!!$  subroutine @X@_mvect_mlt_v(x, y, info)
!!$    class(psb_@X@_multivect_type), intent(inout)  :: x
!!$    class(psb_@X@_multivect_type), intent(inout)  :: y
!!$    integer(psb_ipk_), intent(out)              :: info
!!$    integer(psb_ipk_) :: i, n
!!$
!!$    info = 0
!!$    if (allocated(x%v).and.allocated(y%v)) &
!!$         & call y%v%mlt(x%v,info)
!!$
!!$  end subroutine @X@_mvect_mlt_v
!!$
!!$  subroutine @X@_mvect_mlt_a(x, y, info)
!!$    @TYPE@(@FKIND@), intent(in)        :: x(:)
!!$    class(psb_@X@_multivect_type), intent(inout)  :: y
!!$    integer(psb_ipk_), intent(out)              :: info
!!$    integer(psb_ipk_) :: i, n
!!$
!!$
!!$    info = 0
!!$    if (allocated(y%v)) &
!!$         & call y%v%mlt(x,info)
!!$
!!$  end subroutine @X@_mvect_mlt_a
!!$
!!$
!!$  subroutine @X@_mvect_mlt_a_2(alpha,x,y,beta,z,info)
!!$    @TYPE@(@FKIND@), intent(in)         :: alpha,beta
!!$    @TYPE@(@FKIND@), intent(in)         :: y(:)
!!$    @TYPE@(@FKIND@), intent(in)         :: x(:)
!!$    class(psb_@X@_multivect_type), intent(inout) :: z
!!$    integer(psb_ipk_), intent(out)                  :: info
!!$    integer(psb_ipk_) :: i, n
!!$
!!$    info = 0
!!$    if (allocated(z%v)) &
!!$         & call z%v%mlt(alpha,x,y,beta,info)
!!$
!!$  end subroutine @X@_mvect_mlt_a_2
!!$
!!$  subroutine @X@_mvect_mlt_v_2(alpha,x,y,beta,z,info,conjgx,conjgy)
!!$    @TYPE@(@FKIND@), intent(in)          :: alpha,beta
!!$    class(psb_@X@_multivect_type), intent(inout)  :: x
!!$    class(psb_@X@_multivect_type), intent(inout)  :: y
!!$    class(psb_@X@_multivect_type), intent(inout)  :: z
!!$    integer(psb_ipk_), intent(out)                   :: info
!!$    character(len=1), intent(in), optional :: conjgx, conjgy
!!$
!!$    integer(psb_ipk_) :: i, n
!!$
!!$    info = 0
!!$    if (allocated(x%v).and.allocated(y%v).and.&
!!$         & allocated(z%v)) &
!!$         & call z%v%mlt(alpha,x%v,y%v,beta,info,conjgx,conjgy)
!!$
!!$  end subroutine @X@_mvect_mlt_v_2
!!$
!!$  subroutine @X@_mvect_mlt_av(alpha,x,y,beta,z,info)
!!$    @TYPE@(@FKIND@), intent(in)        :: alpha,beta
!!$    @TYPE@(@FKIND@), intent(in)        :: x(:)
!!$    class(psb_@X@_multivect_type), intent(inout)  :: y
!!$    class(psb_@X@_multivect_type), intent(inout)  :: z
!!$    integer(psb_ipk_), intent(out)              :: info
!!$    integer(psb_ipk_) :: i, n
!!$
!!$    info = 0
!!$    if (allocated(z%v).and.allocated(y%v)) &
!!$         & call z%v%mlt(alpha,x,y%v,beta,info)
!!$
!!$  end subroutine @X@_mvect_mlt_av
!!$
!!$  subroutine @X@_mvect_mlt_va(alpha,x,y,beta,z,info)
!!$    @TYPE@(@FKIND@), intent(in)        :: alpha,beta
!!$    @TYPE@(@FKIND@), intent(in)        :: y(:)
!!$    class(psb_@X@_multivect_type), intent(inout)  :: x
!!$    class(psb_@X@_multivect_type), intent(inout)  :: z
!!$    integer(psb_ipk_), intent(out)              :: info
!!$    integer(psb_ipk_) :: i, n
!!$
!!$    info = 0
!!$
!!$    if (allocated(z%v).and.allocated(x%v)) &
!!$         & call z%v%mlt(alpha,x%v,y,beta,info)
!!$
!!$  end subroutine @X@_mvect_mlt_va
!!$
!!$  subroutine @X@_mvect_scal(alpha, x)
!!$    class(psb_@X@_multivect_type), intent(inout)  :: x
!!$    @TYPE@(@FKIND@), intent (in)       :: alpha
!!$
!!$    if (allocated(x%v)) call x%v%scal(alpha)
!!$
!!$  end subroutine @X@_mvect_scal
!!$
!!$
!!$  function @X@_mvect_nrm2(n,x) result(res)
!!$    class(psb_@X@_multivect_type), intent(inout) :: x
!!$    integer(psb_ipk_), intent(in)           :: n
!!$    @RTYPE@(@FKIND@)                :: res
!!$
!!$    if (allocated(x%v)) then
!!$      res = x%v%nrm2(n)
!!$    else
!!$      res = @RZERO@
!!$    end if
!!$
!!$  end function @X@_mvect_nrm2
!!$
!!$  function @X@_mvect_amax(n,x) result(res)
!!$    class(psb_@X@_multivect_type), intent(inout) :: x
!!$    integer(psb_ipk_), intent(in)           :: n
