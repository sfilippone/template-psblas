  subroutine @X@_mvect_ins(n, irl, val, x, maxr, info)
    use psi_serial_mod
    implicit none
    integer(psb_ipk_), intent(in)               :: n, maxr
    integer(psb_ipk_), intent(in)               :: irl(:)
    @TYPE@(@FKIND@), intent(in)                  :: val(:, :)
    class(psb_@X@_multivect_type), intent(inout)  :: x
    integer(psb_ipk_), intent(out)              :: info

    integer(psb_ipk_) :: i, dupl

    info = psb_success_
    if(.not. allocated(x%v)) then
      info = psb_err_invalid_vect_state_
      return
    end if
    dupl = x%get_dupl()
    call x%v%ins(n, irl, val, dupl, maxr, info)
  end subroutine @X@_mvect_ins

  subroutine @X@_mvect_cnv(x, mold)
    class(psb_@X@_multivect_type), intent(inout)  :: x
    class(psb_@X@_base_multivect_type), intent(in), optional :: mold

    class(psb_@X@_base_multivect_type), allocatable :: tmp
    integer(psb_ipk_) :: info

    if(present(mold)) then
      allocate(tmp, stat = info, mold = mold)
    else
      allocate(tmp, stat = info, mold = psb_@X@_get_base_multivect_default())
    endif

    if(allocated(x%v)) then
      call x%v%sync()
      if(info == psb_success_) call tmp%bld(x%v%v)
      call x%v%free(info)
    end if

    call move_alloc(tmp, x%v)
  end subroutine @X@_mvect_cnv
  @NOTINTS@
  subroutine @X@_mvect_extract_col(m, alpha, x, idx_x, beta, y, info)
    use psi_serial_mod
    use psb_@X@_vect_mod
    implicit none
    integer(psb_ipk_), intent(in)               :: m, idx_x
    @TYPE@(@FKIND@), intent(in)                  :: alpha, beta
    class(psb_@X@_multivect_type), intent(inout)  :: x
    class(psb_@X@_vect_type), intent(inout)       :: y
    integer(psb_ipk_), intent(out)              :: info

    if(.not. allocated(x%v)) then
      info = psb_err_invalid_mvect_state_
      return
    endif

    if(.not. allocated(y%v)) then
      info = psb_err_invalid_vect_state_
      return
    endif

    if(idx_x < 0) then
      info = psb_err_iarg_neg_
      return
    endif

    if(idx_x > x%get_ncols()) then
      info = psb_err_entry_out_of_bounds_
      return
    endif
    
    call x%v%axpby(m, alpha, idx_x, beta, y%v, info)
  end subroutine @X@_mvect_extract_col

  subroutine @X@_mvect_axpby_v_idxs(m, alpha, x, beta, y, idx_y, info)
    use psi_serial_mod
    use psb_@X@_vect_mod
    implicit none
    integer(psb_ipk_), intent(in)               :: m, idx_y
    @TYPE@(@FKIND@), intent(in)                  :: alpha, beta
    class(psb_@X@_vect_type), intent(inout)       :: x
    class(psb_@X@_multivect_type), intent(inout)  :: y
    integer(psb_ipk_), intent(out)              :: info

    if(.not. allocated(x%v)) then
      info = psb_err_invalid_vect_state_
      return
    endif

    if(.not. allocated(y%v)) then
      info = psb_err_invalid_mvect_state_
      return
    endif

    if(idx_y < 0) then
      info = psb_err_iarg_neg_
      return
    endif

    if(idx_y > y%get_ncols()) then
      info = psb_err_entry_out_of_bounds_
      return
    endif
    
    call y%v%axpby(m, alpha, x%v, beta, idx_y, info)
  end subroutine @X@_mvect_axpby_v_idxs
  
  subroutine @X@_mvect_axpby_v_full(m, alpha, x, beta, y, info)
    use psi_serial_mod
    use psb_@X@_vect_mod
    implicit none
    integer(psb_ipk_), intent(in)               :: m
    @TYPE@(@FKIND@), intent(in)                  :: alpha, beta
    class(psb_@X@_vect_type), intent(inout)       :: x
    class(psb_@X@_multivect_type), intent(inout)  :: y
    integer(psb_ipk_), intent(out)              :: info

    if(.not. allocated(x%v)) then
      info = psb_err_invalid_vect_state_ 
      return
    endif

    if(.not. allocated(y%v)) then
      info = psb_err_invalid_mvect_state_ 
      return
    endif
    
    call y%v%axpby(m, alpha, x%v, beta, info)
  end subroutine @X@_mvect_axpby_v_full
  
  subroutine @X@_mvect_axpby_m_idxs(m, alpha, x, idx_x, beta, y, idx_y, info)
    use psi_serial_mod
    implicit none
    integer(psb_ipk_), intent(in)               :: m, idx_x, idx_y
    @TYPE@(@FKIND@), intent(in)                  :: alpha, beta
    class(psb_@X@_multivect_type), intent(inout)  :: x, y
    integer(psb_ipk_), intent(out)              :: info

    if((.not. allocated(x%v)) .or. (.not. allocated(y%v))) then
      info = psb_err_invalid_mvect_state_  
      return
    endif

    if(idx_y <= 0 .or. idx_x <= 0) then
      info = psb_err_iarg_neg_
      return
    endif

    if(idx_y > y%get_ncols() .or. idx_x > x%get_ncols()) then
      info = psb_err_entry_out_of_bounds_
      return
    endif
    
    call y%v%axpby(m, alpha, x%v, idx_x, beta, idx_y, info)
  end subroutine @X@_mvect_axpby_m_idxs
  
  subroutine @X@_mvect_axpby_m_full(m, alpha, x, beta, y, info)
    use psi_serial_mod
    implicit none
    integer(psb_ipk_), intent(in)               :: m
    @TYPE@(@FKIND@), intent(in)                  :: alpha, beta
    class(psb_@X@_multivect_type), intent(inout)  :: x, y
    integer(psb_ipk_), intent(out)              :: info

    if((.not. allocated(x%v)) .or. (.not. allocated(y%v))) then
      info = psb_err_invalid_mvect_state_
      return
    endif

    ! Multivector with different size rise error
    if(x%get_ncols() /= y%get_ncols()) then
      info = psb_err_invalid_mvect_size_
      return
    endif
    
    call y%v%axpby(m, alpha, x%v, beta, info)
  end subroutine @X@_mvect_axpby_m_full

  subroutine @X@_mvect_axpby_m_full_out(m, alpha, x, beta, y, z, info)
    use psi_serial_mod
    implicit none
    integer(psb_ipk_), intent(in)               :: m
    @TYPE@(@FKIND@), intent(in)                  :: alpha, beta
    class(psb_@X@_multivect_type), intent(inout)  :: x, y, z
    integer(psb_ipk_), intent(out)              :: info

    if((.not. allocated(x%v)) .or. (.not. allocated(y%v)) .or. (.not. allocated(y%v))) then
      info = psb_err_invalid_mvect_state_
      return
    endif

    ! Multivector with different size rise error
    if((z%get_ncols() /= x%get_ncols()) .or. (z%get_ncols() /= y%get_ncols())) then
      info = psb_err_invalid_mvect_size_
      return
    endif
    
    call z%v%axpby(m, alpha, x%v, beta, y%v, info)
  end subroutine @X@_mvect_axpby_m_full_out
  
  subroutine @X@_mvect_axpbycz_vv(m, alpha, x, beta, y, gamma, z, idx_z, info)
    use psi_serial_mod
    use psb_@X@_vect_mod
    implicit none
    integer(psb_ipk_), intent(in)               :: m, idx_z
    @TYPE@(@FKIND@), intent(in)                  :: alpha, beta, gamma
    class(psb_@X@_vect_type), intent(inout)       :: x, y
    class(psb_@X@_multivect_type), intent(inout)  :: z
    integer(psb_ipk_), intent(out)              :: info

    if((.not. allocated(x%v)) .or. (.not. allocated(y%v))) then
      info = psb_err_invalid_vect_state_
      return
    endif

    if(.not. allocated(z%v)) then
      info = psb_err_invalid_mvect_state_
      return
    endif

    if(idx_z < 0) then
      info = psb_err_iarg_neg_
      return
    endif

    if(idx_z > z%get_ncols()) then
      info = psb_err_entry_out_of_bounds_
      return
    endif
    
    call z%v%axpby(m, alpha, x%v, beta, y%v, gamma, idx_z, info)
  end subroutine @X@_mvect_axpbycz_vv

  subroutine @X@_mvect_axpbycz_mv(m, alpha, x, beta, y, idx_y, gamma, z, idx_z, info)
    use psi_serial_mod
    use psb_@X@_vect_mod
    implicit none
    integer(psb_ipk_), intent(in)               :: m, idx_y, idx_z
    @TYPE@(@FKIND@), intent(in)                  :: alpha, beta, gamma
    class(psb_@X@_vect_type), intent(inout)       :: x
    class(psb_@X@_multivect_type), intent(inout)  :: y, z
    integer(psb_ipk_), intent(out)              :: info

    if(.not. allocated(x%v)) then
      info = psb_err_invalid_vect_state_
      return
    endif

    if((.not. allocated(y%v)) .or. (.not. allocated(z%v))) then
      info = psb_err_invalid_mvect_state_
      return
    endif

    if(idx_y <= 0 .or. idx_z <= 0) then
      info = psb_err_iarg_neg_
      return
    endif

    if(idx_y > y%get_ncols() .or. idx_z > z%get_ncols()) then
      info = psb_err_entry_out_of_bounds_
      return
    endif
    
    call z%v%axpby(m, alpha, x%v, beta, y%v, idx_y, gamma, idx_z, info)
  end subroutine @X@_mvect_axpbycz_mv

  subroutine @X@_mvect_axpbycz_mm_idxs(m, alpha, x, idx_x, beta, y, idx_y, gamma, z, idx_z, info)
    use psi_serial_mod
    implicit none
    integer(psb_ipk_), intent(in)               :: m, idx_x, idx_y, idx_z
    @TYPE@(@FKIND@), intent(in)                  :: alpha, beta, gamma
    class(psb_@X@_multivect_type), intent(inout)  :: x, y, z
    integer(psb_ipk_), intent(out)              :: info

    if((.not. allocated(x%v)) .or. (.not. allocated(y%v)) .or. (.not. allocated(z%v))) then
      info = psb_err_invalid_mvect_state_
      return
    endif

    if(idx_x <= 0 .or. idx_y <= 0 .or. idx_z <= 0) then
      info = psb_err_iarg_neg_
      return
    endif

    if(idx_x > x%get_ncols() .or. idx_y > y%get_ncols() .or. idx_z > z%get_ncols()) then
      info = psb_err_entry_out_of_bounds_
      return
    endif
    
    call z%v%axpby(m, alpha, x%v, idx_x, beta, y%v, idx_y, gamma, idx_z, info)
  end subroutine @X@_mvect_axpbycz_mm_idxs

  subroutine @X@_mvect_axpbycz_mm_full(m, alpha, x, beta, y, gamma, z, info)
    use psi_serial_mod
    implicit none
    integer(psb_ipk_), intent(in)               :: m
    class(psb_@X@_multivect_type), intent(inout)  :: x, y, z
    @TYPE@(@FKIND@), intent(in)                  :: alpha, beta, gamma
    integer(psb_ipk_), intent(out)              :: info

    if((.not. allocated(x%v)) .or. (.not. allocated(y%v)) .or. (.not. allocated(z%v))) then
      info = psb_err_invalid_mvect_state_
      return
    endif

    if((x%get_ncols() /= y%get_ncols()) .or. (x%get_ncols() /= z%get_ncols())) then
      info = psb_err_invalid_mvect_size_
      return
    endif
    
    call z%v%axpby(m, alpha, x%v, beta, y%v, gamma, info)
  end subroutine @X@_mvect_axpbycz_mm_full
  
  subroutine @X@_mvect_axpbycz_mm_out(m, alpha, x, idx_x, beta, y, idx_y, gamma, z, idx_z, w, idx_w, info)
    use psi_serial_mod
    implicit none
    integer(psb_ipk_), intent(in)               :: m, idx_x, idx_y, idx_z, idx_w
    @TYPE@(@FKIND@), intent(in)                  :: alpha, beta, gamma
    class(psb_@X@_multivect_type), intent(inout)  :: x, y, z, w
    integer(psb_ipk_), intent(out)              :: info

    if((.not. allocated(x%v)) .or. (.not. allocated(y%v)) & 
        .or. (.not. allocated(z%v)).or. (.not. allocated(w%v))) then
      info = psb_err_invalid_mvect_state_
      return
    endif

    if((idx_x <= 0) .or. (idx_y <= 0) .or. (idx_z <= 0) .or. (idx_w <= 0)) then
      info = psb_err_iarg_neg_
      return
    endif

    if((idx_x > x%get_ncols()) .or. (idx_y > y%get_ncols()) & 
          .or. (idx_z > z%get_ncols()) .or. (idx_w > w%get_ncols())) then
      info = psb_err_entry_out_of_bounds_
      return
    endif
    
    call w%v%axpby(m, alpha, x%v, idx_x, beta, y%v, idx_y, gamma, z%v, idx_z, idx_w, info)
  end subroutine @X@_mvect_axpbycz_mm_out
  
