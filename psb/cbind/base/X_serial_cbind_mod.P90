module psb_@X@_serial_cbind_mod
  use iso_c_binding
  use psb_base_mod
  use psb_objhandle_mod
  use psb_base_tools_cbind_mod


  interface
    module function psb_c_@X@vect_get_nrows(xh) bind(c) result(res)
      integer(psb_c_ipk_) :: res
      type(psb_c_@X@vector) :: xh
      
      type(psb_@X@_vect_type), pointer :: vp
      integer(psb_c_ipk_)               :: info
    end function psb_c_@X@vect_get_nrows
  end interface
  
  interface
    module function psb_c_@X@vect_f_get_cpy(v,xh) bind(c) result(res)
      integer(psb_c_ipk_)    :: res
      @TYPE@(@FCKIND@)    :: v(*)
      type(psb_c_@X@vector) :: xh
    end function psb_c_@X@vect_f_get_cpy
  end interface
  

  interface
    module function psb_c_@X@vect_zero(xh) bind(c) result(res)
      integer(psb_c_ipk_)    :: res
      type(psb_c_@X@vector) :: xh
    end function psb_c_@X@vect_zero
  end interface
  
  interface
    module function psb_c_@X@vect_f_get_pnt(xh) bind(c) result(res)
      type(c_ptr)        :: res
      type(psb_c_@X@vector) :: xh
    end function psb_c_@X@vect_f_get_pnt
  end interface

  interface
    module function psb_c_@X@mat_get_nrows(mh) bind(c) result(res)
      integer(psb_c_ipk_) :: res
      type(psb_c_@X@spmat) :: mh
    end function psb_c_@X@mat_get_nrows
  end interface

  interface
    module function psb_c_@X@mat_get_ncols(mh) bind(c) result(res)
      integer(psb_c_ipk_) :: res
      type(psb_c_@X@spmat) :: mh
    end function psb_c_@X@mat_get_ncols
  end interface

  interface
    module function psb_c_@X@mat_name_print(mh,name) bind(c) result(res)
      integer(psb_c_ipk_) :: res
      type(psb_c_@X@spmat) :: mh
      character(c_char)        :: name(*)
    end function psb_c_@X@mat_name_print
  end interface

  interface
    module function psb_c_@X@vect_set_scal(x,val) bind(c) result(info)
      type(psb_c_@X@vector) :: x
      integer(psb_c_ipk_) :: info
      @TYPE@(@FCKIND@), value :: val
    end function psb_c_@X@vect_set_scal
  end interface

  interface
    module function psb_c_@X@vect_set_scal_bound(x,val,ifirst,ilast) bind(c) result(info)
      type(psb_c_@X@vector) :: x
      integer(psb_c_ipk_) :: info
      integer(psb_c_ipk_), value :: ifirst, ilast 
      @TYPE@(@FCKIND@)    :: val
    end function psb_c_@X@vect_set_scal_bound
  end interface

  interface
    module function psb_c_@X@vect_set_vect(x,val,n) bind(c) result(info)
      type(psb_c_@X@vector) :: x
      integer(psb_c_ipk_) :: info
      integer(psb_c_ipk_), value :: n
      @TYPE@(@FCKIND@)    :: val(*)
    end function psb_c_@X@vect_set_vect
  end interface

  interface
    module function psb_c_@X@vect_set_entry(x,index,val) bind(c) result(info)
      type(psb_c_@X@vector) :: x
      integer(psb_c_ipk_) :: info
      integer(psb_c_ipk_), value :: index
      @TYPE@(@FCKIND@), value :: val
    end function psb_c_@X@vect_set_entry
  end interface
 
  interface
    module function psb_c_@X@vect_get_entry(x,index) bind(c) result(res)
      type(psb_c_@X@vector) :: x
      integer(psb_c_ipk_), value :: index
      @TYPE@(@FCKIND@) :: res
    end function psb_c_@X@vect_get_entry
  end interface

  interface
    module function psb_c_@X@vect_clone(xh,yh) bind(c) result(info)
      integer(psb_c_ipk_) :: info
      type(psb_c_@X@vector) :: xh,yh
    end function psb_c_@X@vect_clone
  end interface

end module psb_@X@_serial_cbind_mod
