module psb_@X@_tools_cbind_mod
  use iso_c_binding
  use psb_base_mod
  use psb_cpenv_mod
  use psb_objhandle_mod
  use psb_base_tools_cbind_mod
#ifdef PSB_HAVE_CUDA
  use psb_cuda_mod
#endif
  
  ! Should define   geall_opt  with DUPL argument
  interface
    module function psb_c_@X@geall(xh,cdh) bind(c) result(res)
      integer(psb_c_ipk_) :: res
      type(psb_c_@X@vector) :: xh
      type(psb_c_descriptor) :: cdh
    end function psb_c_@X@geall
  end interface

  interface
    module function psb_c_@X@geall_remote(xh,cdh) bind(c) result(res)
      integer(psb_c_ipk_) :: res
      type(psb_c_@X@vector) :: xh
      type(psb_c_descriptor) :: cdh
      
    end function psb_c_@X@geall_remote
  end interface

  interface
    module function psb_c_@X@geall_remote_options(xh,cdh,bldmode,dupl) bind(c) result(res)
      integer(psb_c_ipk_) :: res
      type(psb_c_@X@vector) :: xh
      type(psb_c_descriptor) :: cdh
      integer(psb_c_ipk_), value :: dupl
      integer(psb_c_ipk_), value :: bldmode
    end function psb_c_@X@geall_remote_options
  end interface

  interface
    module function psb_c_@X@geasb(xh,cdh) bind(c) result(res)
      integer(psb_c_ipk_) :: res
      type(psb_c_@X@vector) :: xh
      type(psb_c_descriptor) :: cdh
    end function psb_c_@X@geasb
  end interface
  
  interface
    module function psb_c_@X@geasb_options(xh,cdh,dupl) bind(c) result(res)
      integer(psb_c_ipk_) :: res
      type(psb_c_@X@vector) :: xh
      type(psb_c_descriptor) :: cdh
      integer(psb_c_ipk_), value :: dupl
    end function psb_c_@X@geasb_options
  end interface
  
  interface
    module function psb_c_@X@geasb_options_format(xh,cdh,dupl,format) bind(c) result(res)
      ! Takes into account format argument as a c string, and uses it to call the appropriate psb_geasb
      ! with mold argument
      integer(psb_c_ipk_) :: res
      type(psb_c_@X@vector) :: xh
      type(psb_c_descriptor) :: cdh
      character(kind=c_char), dimension(*) :: format
      integer(psb_c_ipk_), value :: dupl
    end function psb_c_@X@geasb_options_format
  end interface
   
  interface
    module function psb_c_@X@gefree(xh,cdh) bind(c) result(res)
      integer(psb_c_ipk_) :: res
      type(psb_c_@X@vector) :: xh
      type(psb_c_descriptor) :: cdh
    end function psb_c_@X@gefree
  end interface

  interface
    module function psb_c_@X@geins(nz,irw,val,xh,cdh) bind(c) result(res)
      integer(psb_c_ipk_) :: res
      integer(psb_c_ipk_), value :: nz
      integer(psb_c_lpk_)        :: irw(*)
      @TYPE@(@FCKIND@)        :: val(*)
      type(psb_c_@X@vector) :: xh
      type(psb_c_descriptor) :: cdh
    end function psb_c_@X@geins
  end interface

  interface
    module function psb_c_@X@spall(mh,cdh) bind(c) result(res)
      integer(psb_c_ipk_) :: res
      type(psb_c_@X@spmat) :: mh
      type(psb_c_descriptor) :: cdh
    end function psb_c_@X@spall
  end interface
  
  interface
    module function psb_c_@X@spall_remote(mh,cdh) bind(c) result(res)
      integer(psb_c_ipk_) :: res
      type(psb_c_@X@spmat) :: mh
      type(psb_c_descriptor) :: cdh
    end function psb_c_@X@spall_remote
  end interface

  interface
    module function psb_c_@X@spasb(mh,cdh) bind(c) result(res)
      integer(psb_c_ipk_) :: res
      type(psb_c_@X@spmat) :: mh
      type(psb_c_descriptor) :: cdh
    end function psb_c_@X@spasb
  end interface

  interface
    module function psb_c_@X@spfree(mh,cdh) bind(c) result(res)
      integer(psb_c_ipk_) :: res
      type(psb_c_@X@spmat) :: mh
      type(psb_c_descriptor) :: cdh
    end function psb_c_@X@spfree
  end interface

  interface
    module function psb_c_@X@spasb_opt(mh,cdh,afmt,upd,dupl) bind(c) result(res)
      integer(psb_c_ipk_) :: res
      type(psb_c_@X@spmat) :: mh
      type(psb_c_descriptor) :: cdh
      integer(psb_c_ipk_), value :: upd,dupl
      character(c_char)     :: afmt(*)
    end function psb_c_@X@spasb_opt
  end interface

  interface
    module function psb_c_@X@spins(nz,irw,icl,val,mh,cdh) bind(c) result(res)
      integer(psb_c_ipk_) :: res
      integer(psb_c_ipk_), value :: nz
      integer(psb_c_lpk_)      :: irw(*), icl(*)
      @TYPE@(@FCKIND@)        :: val(*)
      type(psb_c_@X@spmat) :: mh
      type(psb_c_descriptor) :: cdh
    end function psb_c_@X@spins
  end interface

  interface
    module function psb_c_@X@sprn(mh,cdh,clear) bind(c) result(res)
      integer(psb_c_ipk_) :: res
      logical(c_bool), value :: clear
      type(psb_c_@X@spmat) :: mh
      type(psb_c_descriptor) :: cdh
    end function psb_c_@X@sprn
  end interface
!!$
!!$  module function psb_c_@X@spprint(mh) bind(c) result(res)
!!$
!!$    implicit none
!!$    integer(psb_c_ipk_) :: res
!!$    integer(psb_c_ipk_),  value :: mh
!!$    integer(psb_c_ipk_)         :: info
!!$
!!$
!!$    res = -1
!!$    call psb_check_double_spmat_handle(mh,info)
!!$    if (info < 0) return
!!$
!!$    call psb_csprt(0,double_spmat_pool(mh)%item,head='Debug mat')
!!$
!!$    res = 0
!!$
!!$    return
!!$  end function psb_c_@X@spprint

@NOTINTS@
  interface 
    module function psb_c_@X@getelem(xh,index,cdh) bind(c) result(res)
      type(psb_c_@X@vector)      :: xh
      integer(psb_c_lpk_), value :: index
      type(psb_c_descriptor)     :: cdh
      @TYPE@(@FCKIND@)           :: res
    end function psb_c_@X@getelem
  end interface
  
  interface 
    module function psb_c_@X@setelem(index,val,xh,cdh) bind(c) result(res)
      type(psb_c_@X@vector)      :: xh
      integer(psb_c_lpk_), value :: index
      type(psb_c_descriptor)     :: cdh
      @TYPE@(@FCKIND@), value    :: val
      integer(psb_c_ipk_) :: res
    end function psb_c_@X@setelem
  end interface

  interface 
    module function psb_c_@X@matgetelem(ah,rowindex,colindex,cdh) bind(c) result(res)
      type(psb_c_@X@spmat)      :: ah
      integer(psb_c_lpk_), value :: rowindex, colindex
      type(psb_c_descriptor)     :: cdh
      @TYPE@(@FCKIND@)           :: res
    end function psb_c_@X@matgetelem
  end interface
@NOTINTE@

end module psb_@X@_tools_cbind_mod
