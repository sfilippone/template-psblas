module psb_@X@_comm_cbind_mod
  use iso_c_binding
  use psb_base_mod
  use psb_objhandle_mod

  interface
    module function psb_c_@X@ovrl(xh,cdh) bind(c) result(res)
      integer(psb_c_ipk_) :: res
      type(psb_c_@X@vector) :: xh
      type(psb_c_descriptor) :: cdh
    end function psb_c_@X@ovrl
  end interface

  interface
    module function psb_c_@X@ovrl_opt(xh,cdh,update,mode) bind(c) result(res)
      integer(psb_c_ipk_) :: res
      integer(psb_c_ipk_), value :: update, mode
      type(psb_c_@X@vector) :: xh
      type(psb_c_descriptor) :: cdh
    end function psb_c_@X@ovrl_opt
  end interface


  interface
    module function psb_c_@X@halo(xh,cdh) bind(c) result(res)
      integer(psb_c_ipk_) :: res
      type(psb_c_@X@vector) :: xh
      type(psb_c_descriptor) :: cdh
    end function psb_c_@X@halo
  end interface

  interface
    module function psb_c_@X@halo_opt(xh,cdh,tran,data,mode) bind(c) result(res)
      integer(psb_c_ipk_) :: res
      integer(psb_c_ipk_), value :: data, mode
      character(c_char)      :: tran
      type(psb_c_@X@vector) :: xh
      type(psb_c_descriptor) :: cdh
    end function psb_c_@X@halo_opt
  end interface

  interface
    module function psb_c_@X@vscatter(ng,gx,xh,cdh) bind(c) result(res)
      integer(psb_c_ipk_)    :: res
      integer(psb_c_lpk_), value :: ng
      @TYPE@(@FCKIND@), target :: gx(*)
      type(psb_c_@X@vector) :: xh
      type(psb_c_descriptor) :: cdh
    end function psb_c_@X@vscatter
  end interface

  interface
    module function psb_c_@X@vgather_f(v,xh,cdh) bind(c) result(res)
      integer(psb_c_ipk_)    :: res
      @TYPE@(@FCKIND@), target :: v(*)
      type(psb_c_@X@vector) :: xh
      type(psb_c_descriptor) :: cdh
    end function psb_c_@X@vgather_f
  end interface

  interface
    module function psb_c_@X@spgather_f(gah,ah,cdh) bind(c) result(res)
      integer(psb_c_ipk_)    :: res
      type(psb_c_@X@spmat)   :: ah, gah
      type(psb_c_descriptor) :: cdh
    end function psb_c_@X@spgather_f
  end interface
  
end module psb_@X@_comm_cbind_mod
