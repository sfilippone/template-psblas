  interface spsvCSRGDevice
    function @X@_spsvCSRGDevice(Mat, alpha, x, beta, y) result(res) &
        & bind(c, name = "@X@_spsvCSRGDevice")
      use iso_c_binding
      import @X@_Cmat
      type(@X@_Cmat)          :: Mat
      type(c_ptr), value    :: x
      type(c_ptr), value    :: y
      @TYPE@(@FCKIND@), value :: alpha, beta
      integer(c_int)  :: res
    end function @X@_spsvCSRGDevice
  end interface
  
  interface spmvCSRGDevice
    function @X@_spmvCSRGDeviceF(mat, alpha, x, beta, y) result(res) &
        & bind(c, name = "@X@_spmvCSRGDeviceF")
      use iso_c_binding
      import @X@_Cmat
      type(@X@_Cmat)          :: mat
      @TYPE@(@FCKIND@), value :: alpha, beta
      type(c_ptr), value    :: x, y
      integer(c_int)  :: res
    end function @X@_spmvCSRGDeviceF

    function @X@_spmvCSRGDeviceMV(mat, alpha, x, beta, y, idx_y) result(res) &
        & bind(c, name = "@X@_spmvCSRGDeviceMV")
      use iso_c_binding
      import @X@_Cmat
      type(@X@_Cmat)          :: mat
      @TYPE@(@FCKIND@), value :: alpha, beta
      type(c_ptr), value    :: x, y
      integer(c_int), value :: idx_y
      integer(c_int)  :: res
    end function @X@_spmvCSRGDeviceMV

    function @X@_spmvCSRGDeviceVM(mat, alpha, x, idx_x, beta, y) result(res) &
        & bind(c, name = "@X@_spmvCSRGDeviceVM")
      use iso_c_binding
      import @X@_Cmat
      type(@X@_Cmat)          :: mat
      @TYPE@(@FCKIND@), value :: alpha, beta
      type(c_ptr), value    :: x, y
      integer(c_int), value :: idx_x
      integer(c_int)  :: res
    end function @X@_spmvCSRGDeviceVM
    
    function @X@_spmvCSRGDeviceMMi(mat, alpha, x, idx_x, beta, y, idx_y) result(res) &
        & bind(c, name = "@X@_spmvCSRGDeviceMMi")
      use iso_c_binding
      import @X@_Cmat
      type(@X@_Cmat)          :: mat
      @TYPE@(@FCKIND@), value :: alpha, beta
      type(c_ptr), value    :: x, y
      integer(c_int), value :: idx_x, idx_y
      integer(c_int)  :: res
    end function @X@_spmvCSRGDeviceMMi
  end interface
  
  interface CSRGHost2Device
    function @X@_CSRGHost2Device(Mat, m, n, nz, irp, ja, val) result(res) &
        & bind(c, name = "@X@_CSRGHost2Device")
      use iso_c_binding
      import @X@_Cmat
      type(@X@_Cmat)          :: Mat
      integer(c_int), value :: m, n, nz
      integer(c_int)        :: irp(*), ja(*)
      @TYPE@(@FCKIND@)        :: val(*)
      integer(c_int)  :: res
    end function @X@_CSRGHost2Device
  end interface
  
  interface CSRGDevice2Host
    function @X@_CSRGDevice2Host(Mat, m, n, nz, irp, ja, val) result(res) &
        & bind(c, name = "@X@_CSRGDevice2Host")
      use iso_c_binding
      import @X@_Cmat
      type(@X@_Cmat)          :: Mat
