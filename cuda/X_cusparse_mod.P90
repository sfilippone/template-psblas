  interface CSRGDeviceAlloc
    function @X@_CSRGDeviceAlloc(Mat, nr, nc, nz) result(res) &
        & bind(c, name = "@X@_CSRGDeviceAlloc")
      use iso_c_binding
      import @X@_Cmat
      type(@X@_Cmat)          :: Mat
      integer(c_int), value :: nr, nc, nz
      integer(c_int)  :: res
    end function @X@_CSRGDeviceAlloc
  end interface

  interface CSRGDeviceGetParms
    function @X@_CSRGDeviceGetParms(Mat, nr, nc, nz) result(res) &
        & bind(c, name = "@X@_CSRGDeviceGetParms")
      use iso_c_binding
      import @X@_Cmat
