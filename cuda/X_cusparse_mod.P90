      type(@X@_Cmat)          :: Mat
      integer(c_int), value :: type
      integer(c_int)  :: res
    end function @X@_CSRGDeviceSetMatIndexBase
  end interface
  
#if PSB_CUDA_SHORT_VERSION <= 10  
