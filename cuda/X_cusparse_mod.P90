module @X@_cusparse_mod
  use base_cusparse_mod
  
  type, bind(c) :: @X@_Cmat
    type(c_ptr) :: Mat = c_null_ptr
  end type @X@_Cmat
  
#if PSB_CUDA_SHORT_VERSION <= 10 
  type, bind(c) :: @X@_Hmat
    type(c_ptr) :: Mat = c_null_ptr
  end type @X@_Hmat
#endif
  
  interface CSRGDeviceFree
    function @X@_CSRGDeviceFree(Mat) result(res) &
        & bind(c, name = "@X@_CSRGDeviceFree")
      use iso_c_binding
      import @X@_Cmat
      type(@X@_Cmat)   :: Mat
      integer(c_int) :: res
    end function @X@_CSRGDeviceFree
  end interface
  
  interface CSRGDeviceSetMatType
    function @X@_CSRGDeviceSetMatType(Mat, type) result(res) &
        & bind(c, name = "@X@_CSRGDeviceSetMatType")
      use iso_c_binding
      import @X@_Cmat
      type(@X@_Cmat)          :: Mat
      integer(c_int), value :: type
      integer(c_int)  :: res
    end function @X@_CSRGDeviceSetMatType
  end interface
  
